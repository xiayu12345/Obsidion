+++ b/openwrt/target/h133/h133-p1_nor_ZS101/defconfig
@@ -2805,7 +2805,7 @@ CONFIG_AW_ION_ALLOC_IOMMU=y
 # CONFIG_PACKAGE_cpu_monitor is not set
 CONFIG_PACKAGE_libkey=y
 # CONFIG_LIBKEY_STATIC is not set
-# CONFIG_PACKAGE_libkey-demo is not set
+CONFIG_PACKAGE_libkey-demo=y
 # CONFIG_PACKAGE_librpbuf is not set
 # CONFIG_PACKAGE_librpmsg is not set
 CONFIG_PACKAGE_mtop=y
