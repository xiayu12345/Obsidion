+#define AAS_USB_VOICE_FIFO "/tmp/aas_cmd"
+#define AAS_USB_VOICE_APP  "usb_remote"
+
+/* 天猫空鼠语音键=KEY_F24；只打 AAS FIFO，不注入 LVGL。source=usb，麦没有则 daemon 失败不回退 AC107 */
+static void keypad_usb_remote_voice(int press)
+{
+    static uint32_t seq = 1;
+    char line[128];
+    int fd;
+    size_t len;
+
+    if (press) {
+        snprintf(line, sizeof(line),
+                 "VOICE START app=%s source=usb seq=%u\n", AAS_USB_VOICE_APP, seq);
+    } else {
+        snprintf(line, sizeof(line),
+                 "VOICE STOP app=%s seq=%u\n", AAS_USB_VOICE_APP, seq);
+        seq++;
+        if (seq == 0U) {
+            seq = 1U;
+        }
+    }
+    fd = open(AAS_USB_VOICE_FIFO, O_WRONLY | O_NONBLOCK);
+    if (fd < 0) {
+        return;
+    }
+    len = strlen(line);
+    (void)write(fd, line, len);
+    close(fd);
+}
