+/* sysfs device 链到 usb 的 card 才是遥控麦；找不到则失败，禁止改走 AC107 */
+static int aas_capture_find_usb_plughw(char *out, size_t out_len)
+{
+    DIR *dir;
+    struct dirent *ent;
+    char sys[128];
+    char link[256];
+    ssize_t n;
+    int card = -1;
+    const char *p;
+    int digits;
+
+    dir = opendir("/sys/class/sound");
+    if (!dir) {
+        return -1;
+    }
+    while ((ent = readdir(dir)) != NULL) {
+        if (strncmp(ent->d_name, "card", 4) != 0) {
+            continue;
+        }
+        p = ent->d_name + 4;
+        if (*p == '\0') {
+            continue;
+        }
+        digits = 1;
+        while (*p) {
+            if (*p < '0' || *p > '9') {
+                digits = 0;
+                break;
+            }
+            p++;
+        }
+        if (!digits) {
+            continue;
+        }
+        snprintf(sys, sizeof(sys), "/sys/class/sound/%s/device", ent->d_name);
+        n = readlink(sys, link, sizeof(link) - 1);
+        if (n <= 0) {
+            continue;
+        }
+        link[n] = '\0';
+        if (strstr(link, "usb") == NULL && strstr(link, "USB") == NULL) {
+            continue;
+        }
+        card = atoi(ent->d_name + 4);
+        break;
+    }
+    closedir(dir);
+    if (card < 0 || out == NULL || out_len < 16) {
+        return -1;
+    }
+    snprintf(out, out_len, "plughw:%d,0", card);
+    return 0;
+}
