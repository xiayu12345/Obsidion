filters:
  and:
    - 'type == "project"'
properties:
  title:
    displayName: 项目
  status:
    displayName: 状态
  config:
    displayName: 板型
  start:
    displayName: 开始
views:
  - type: table
    name: 进行中
    filters:
      and:
        - 'status != "交付"'
    order:
      - title
      - status
      - config
      - start
  - type: table
    name: 全部
    order:
      - title
      - status
      - config
      - start
