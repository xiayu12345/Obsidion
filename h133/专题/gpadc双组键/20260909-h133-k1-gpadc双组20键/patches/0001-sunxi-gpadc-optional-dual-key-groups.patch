+static void sunxi_gpadc_key_group_work(struct work_struct *work)
+{
+	struct sunxi_gpadc *chip =
+		container_of(to_delayed_work(work), struct sunxi_gpadc,
+			     key_group_work);
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->key_group_lock, flags);
+	if (!chip->key_pressed) {
+		chip->key_group_b = !chip->key_group_b;
+		gpiod_set_value(chip->key_group_gpio, chip->key_group_b);
+	}
+	spin_unlock_irqrestore(&chip->key_group_lock, flags);
+
+	schedule_delayed_work(&chip->key_group_work,
+			      msecs_to_jiffies(KEY_GROUP_SCAN_INTERVAL_MS));
+}
