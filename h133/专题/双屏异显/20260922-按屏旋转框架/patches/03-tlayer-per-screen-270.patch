+/* 270° 中间图（G2D 180，尺寸与源同）；与 mRotateBufInfo 最终 90° 缓冲分开 */
+static int ensureDualDispMid180Buf(LayerContext *lc, const VideoPicture *src)
+{
+    VideoPicture *mid;
+    char *pVirBuf;
+    char *pPhyBuf;
+    int nBufferFd;
+    int w = src->nWidth;
+    int h = src->nHeight;
+
+    mid = &lc->mRotateExtraBufInfo.pPicture;
+    if (mid->pData0 != NULL && mid->nWidth == w && mid->nHeight == h
+            && mid->ePixelFormat == src->ePixelFormat)
+        return 0;
+
+    if (mid->pData0 != NULL) {
+        SunxiMemPfree(lc->pMemops, mid->pData0);
+        mid->pData0 = NULL;
+    }
+
+    pVirBuf = (char *)SunxiMemPalloc(lc->pMemops, (size_t)w * h * 3 / 2);
+    if (pVirBuf == NULL) {
+        loge("[MIPI-VID] mid180 SunxiMemPalloc fail %dx%d", w, h);
+        return -1;
+    }
+    nBufferFd = SunxiMemGetBufferFd(lc->pMemops, pVirBuf);
+    pPhyBuf = (char *)SunxiMemGetPhysicAddressCpu(lc->pMemops, pVirBuf);
+
+    memset(mid, 0, sizeof(*mid));
+    mid->nWidth = w;
+    mid->nHeight = h;
+    mid->nLineStride = w;
+    mid->pData0 = pVirBuf;
+    mid->pData1 = pVirBuf + (w * h);
+    mid->pData2 = mid->pData1 + (w * h) / 4;
+    mid->nBufFd = nBufferFd;
+    mid->phyYBufAddr = (uintptr_t)pPhyBuf;
+    mid->phyCBufAddr = mid->phyYBufAddr + (uintptr_t)(w * h);
+    mid->ePixelFormat = src->ePixelFormat;
+    mid->nLeftOffset = 0;
+    mid->nTopOffset = 0;
+    mid->nRightOffset = w;
+    mid->nBottomOffset = h;
+    return 0;
+}
