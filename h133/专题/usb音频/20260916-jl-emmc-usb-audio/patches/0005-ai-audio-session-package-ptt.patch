--- a/openwrt/package/thirdparty/gui/lvgl-8/ai_audio_session/files/aas_f24_ptt.init
+++ b/openwrt/package/thirdparty/gui/lvgl-8/ai_audio_session/files/aas_f24_ptt.init
@@ -0,0 +1,16 @@
+#!/bin/sh /etc/rc.common
+# aas_f24_ptt —— 2.4G KEY_F24 → ai_audio_sessiond VOICE
+
+START=84
+USE_PROCD=1
+
+PROG=/usr/bin/aas_f24_ptt
+
+start_service() {
+	procd_open_instance
+	procd_set_param command "$PROG"
+	procd_set_param respawn
+	procd_set_param stdout 1
+	procd_set_param stderr 1
+	procd_close_instance
+}
