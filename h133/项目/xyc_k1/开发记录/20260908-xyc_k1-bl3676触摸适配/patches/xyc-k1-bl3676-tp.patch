+	ts->irq_gpio_dir = 0;
+	BTL_GPIO_OUTPUT(ts->irq_gpio_number, 1);
+	ts->irq_gpio_level = 1;
+	msleep(20);
+	BTL_GPIO_OUTPUT(ts->irq_gpio_number, 0);
+  	ts->irq_gpio_level = 1;
+	msleep(1);
+	BTL_GPIO_OUTPUT(ts->irq_gpio_number, 1);
+	ts->irq_gpio_level = 1;
+	msleep(20);
+}
