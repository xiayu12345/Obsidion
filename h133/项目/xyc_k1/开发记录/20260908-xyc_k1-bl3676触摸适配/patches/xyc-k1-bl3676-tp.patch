+#if defined(ESD_MECHANISM_OLD)
+static void btl_esd_check_work(struct work_struct *work)
+{
+    int ret = -1;
+    unsigned char cmdEsd = BTL_ESD_REG;
+	unsigned char buf[4] = {0x00};
+    struct btl_ts_data *ts = NULL;
+
+	ts = container_of(work, struct btl_ts_data, esd_work.work);
+	
+    if(ts->esd_need_block) {
+        BTL_DEBUG("Esd need block!\n");
+        goto ESD_PROTECT_ERROR;
+    }	
+    if(ts->bl_is_suspend) {
+        BTL_DEBUG("Esd suspended!\n");
+        goto ESD_PROTECT_ERROR;
+    }
+
+	btl_i2c_lock();
+    ret = btl_i2c_write_read(ts->client,CTP_SLAVE_ADDR, &cmdEsd, 1, buf,sizeof(buf));
+	btl_i2c_unlock();
+    if(ret < 0)
+    {
+        BTL_DEBUG("i2c module abnormal need recovery!\n");
+		btl_esd_recovery(ts);
+    }
+    else
+    {
+        if(memcmp(ts->esd_value, buf, sizeof(buf)) == 0)
+        {
+            BTL_DEBUG("IC abnormal need recovery!\n");
+		    btl_esd_recovery(ts);       
+        }
+		memcpy(ts->esd_value, buf, sizeof((buf)));
+		BTL_DEBUG("ts->esd_value %x %x %x %x!\n",ts->esd_value[0], ts->esd_value[1], ts->esd_value[2], ts->esd_value[3]);
+    }
+
+ESD_PROTECT_ERROR:
+    if(!ts->bl_is_suspend) {
+        queue_delayed_work(ts->btl_assist_wq, &ts->esd_work, ts->clk_tick_cnt_esd);
+    } else {
+        BTL_DEBUG("Esd suspended!");
+    }
+}
+
+#elif defined(ESD_MECHANISM_NEW)
+static void btl_esd_check_work(struct work_struct *work)
+{
+    int ret = -1;
+    int retry = 5;
+    unsigned char cmdEsd = BTL_ESD_REG_NEW;
+	unsigned char buf[4] = {0xaa, 0xaa, 0x55, 0x55};
+    struct btl_ts_data *ts = NULL;
+
+	ts = container_of(work, struct btl_ts_data, esd_work.work);
+	
+    if(ts->esd_need_block) {
+        BTL_DEBUG("Esd need block!\n");
+        goto ESD_PROTECT_ERROR;
+    }	
+    if(ts->bl_is_suspend) {
+        BTL_DEBUG("Esd suspended!\n");
+        goto ESD_PROTECT_ERROR;
+    }
+
+    while(retry--)
+    {
+    	btl_i2c_lock();
+        ret = btl_i2c_write_read(ts->client,CTP_SLAVE_ADDR, &cmdEsd, 1, ts->esd_value,sizeof(buf));
+    	btl_i2c_unlock();
+		BTL_DEBUG("ts->esd_value %x %x %x %x!\n",ts->esd_value[0], ts->esd_value[1], ts->esd_value[2], ts->esd_value[3]);
+        if(memcmp(ts->esd_value, buf, sizeof(buf)))
+        {
+            continue;
+        }
+        else
+        {
+            break;
+        }
+    }
+    if(retry < 0)
+    {
+        BTL_DEBUG("IC abnormal need recovery!\n");
+		btl_esd_recovery(ts); 
+    }
+
+ESD_PROTECT_ERROR:
+    if(!ts->bl_is_suspend) {
+        queue_delayed_work(ts->btl_assist_wq, &ts->esd_work, ts->clk_tick_cnt_esd);
+    } else {
+        BTL_DEBUG("Esd suspended!");
+    }
+}
+
+#endif
+static int btl_ts_esd_check_init(struct btl_ts_data* ts)
+{
+    int ret = 0;
+    INIT_DELAYED_WORK(&ts->esd_work, btl_esd_check_work);
+    ts->clk_tick_cnt_esd = 3 * HZ;
+	ts->esd_need_block = 0;
+	ts->esd_running = 0;
+	memset(ts->esd_value, 0, sizeof(ts->esd_value));
+    spin_lock_init(&ts->esd_lock);
+	return ret;
+}
+
+void btl_esd_switch(struct btl_ts_data *ts, s32 on)
+{
+    spin_lock(&ts->esd_lock);
+    if(SWITCH_ON == on) {
+        if(!ts->esd_running) {
+            ts->esd_running = 1;
+            spin_unlock(&ts->esd_lock);
+            BTL_DEBUG("started");
+            queue_delayed_work(ts->btl_assist_wq, &ts->esd_work, ts->clk_tick_cnt_esd);
+        } else {
+            spin_unlock(&ts->esd_lock);
+        }
+
+    } else {
+        if(ts->esd_running) {
+            ts->esd_running = 0;
+            spin_unlock(&ts->esd_lock);
+            BTL_DEBUG("cancelled");
+            cancel_delayed_work_sync(&ts->esd_work);
+        } else {
+            spin_unlock(&ts->esd_lock);
+        }
+    }
+}
