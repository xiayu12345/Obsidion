+    	size = VERTIFY_START_OFFSET + BTL_ARGUMENT_BASE_OFFSET - i;
+    	if(size > FLASH_WSIZE){
+    		len = FLASH_WSIZE;
+    	}else{
+    		len = size;
+    	}
