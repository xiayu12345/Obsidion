@@ -27,6 +27,43 @@
  */
 static bool g_page_nav_loading = false;
 
+#ifndef PAGE_NAV_INPUT_BLOCK_MS
+#define PAGE_NAV_INPUT_BLOCK_MS  100  /* 切屏后屏蔽触摸，单位 ms */
+#endif
+
+static lv_timer_t *g_page_nav_indev_timer = NULL;
+
+static void page_nav_indev_restore_timer_cb(lv_timer_t *timer)
+{
+    if (timer == g_page_nav_indev_timer) {
+        g_page_nav_indev_timer = NULL;
+    }
+
+    lv_indev_enable(NULL, true);
+    lv_timer_del(timer);
+}
+
+static void page_nav_block_input_temporarily(void)
+{
+    if (g_page_nav_indev_timer != NULL) {
+        lv_timer_del(g_page_nav_indev_timer);
+        g_page_nav_indev_timer = NULL;
+    }
+
+    lv_indev_enable(NULL, false);
+    lv_indev_reset(NULL, NULL);
+    LVGL8_APP_LOGI("hy_app", "page_nav", "indev block %ums",
+                   (unsigned)PAGE_NAV_INPUT_BLOCK_MS);
+
+    g_page_nav_indev_timer = lv_timer_create(page_nav_indev_restore_timer_cb,
+                                             PAGE_NAV_INPUT_BLOCK_MS,
+                                             NULL);
+    if (g_page_nav_indev_timer != NULL) {
+        lv_timer_set_repeat_count(g_page_nav_indev_timer, 1);
+    } else {
+        lv_indev_enable(NULL, true);
+    }
+}
 
 extern void ui_load_scr_animation(lv_ui *ui,
