+++ b/platform/allwinner/display/libuapi/src/include/disp_dual.h
@@ -0,0 +1,53 @@
+/*
+ * MIPI+HDMI 同显/异显（libuapi）
+ *
+ * WB 管道由内核启动后常开；切模式只显隐 HDMI 上的 WB 层 + 视频贴屏：
+ *   SAME：HDMI 显示 WB，视频 DE0
+ *   DIFF：关 HDMI 上 WB 层（腾 DE1），视频 DE1（须已插 HDMI）
+ * 播中勿切；未插 HDMI 时视频强制 LCD
+ */
+#ifndef __DISP_DUAL_H__
+#define __DISP_DUAL_H__
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+	SUNXI_DISP_MODE_SAME = 0,
+	SUNXI_DISP_MODE_DIFF = 1,
+} sunxi_disp_mode_t;
+
+#define SUNXI_DISP_KTV_STATE_IDLE (-2)
+
+#ifndef DISP_DUAL_DISPLAY_ENABLE
+#define DISP_DUAL_DISPLAY_ENABLE       0x407
+#define DISP_DUAL_DISPLAY_GET_EN       0x409
+#define DISP_FB_CLONE_ALLOW_SET        0x40a
+#define DISP_FB_CLONE_ALLOW_GET        0x40b
+#endif
+#ifndef DISP_DUAL_DISPLAY_SET_HDMI_OUT
+#define DISP_DUAL_DISPLAY_SET_HDMI_OUT 0x40c
+#define DISP_DUAL_DISPLAY_GET_HDMI_OUT 0x40d
+#endif
+
+/* HDMI 上 WB 层显隐（不拆 capture/wq） */
+int sunxi_dual_display_set_hdmi_output(int on);
+int sunxi_dual_display_get_hdmi_output(void);
+int sunxi_dual_display_is_enabled(void);
+
+int sunxi_disp_hdmi_connected(void);
+
+int sunxi_disp_mode_get(sunxi_disp_mode_t *mode);
+int sunxi_disp_mode_set(sunxi_disp_mode_t mode);
+int sunxi_disp_mode_apply(sunxi_disp_mode_t mode);
+int sunxi_disp_mode_boot_sync(void);
+
+/* LayerCreate：未插 HDMI→1；DIFF+已插→2；否则 1 */
+int sunxi_disp_video_screen_mask(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __DISP_DUAL_H__ */
