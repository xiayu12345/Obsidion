-# Switch: /usr/bin/audio_route.sh spdif|hdmi|lineout|auto
+# K1: playback routes i2s | spdif | hdmi | lineout(HPOUT)
+# Switch: /usr/bin/audio_route.sh i2s|spdif|hdmi|lineout|auto
+# 默认 I2S1 → BP1048 DSP（PG11–PG15）
+
+pcm.PlaybackI2S {
