 # lineout：audiocodec HPOUT + LINEOUT（设置页第三项）
-# UI: Speaker(0)->spdif, ARC(1)->hdmi, Headphone(3)->lineout
+# UI: Speaker(0)->i2s（K1 喇叭在 DSP），ARC(1)->hdmi, Headphone(3)->lineout, I2S(5)->i2s
 
 ASOUND="/etc/asound.conf"
 MODE_FILE="/etc/audio_output.mode"
 ACARD="hw:audiocodec"
 
 usage() {
-    echo "用法: audio_route.sh spdif|hdmi|lineout|auto|show"
+    echo "用法: audio_route.sh i2s|spdif|hdmi|lineout|auto|show"
     echo "当前: $(cat "$MODE_FILE" 2>/dev/null || echo unknown)"
 }
 
@@ -39,11 +40,12 @@ resolve_mode_from_setting() {
     [ -f /mnt/UDISK/setting.ini ] || return 1
     so=$(grep -E '^sound_output[[:space:]]*=' /mnt/UDISK/setting.ini | tail -1 | sed 's/.*=[[:space:]]*//')
     case "$so" in
-        0) echo spdif ;;
+        0) echo i2s ;;    # K1 喇叭走 I2S1→DSP，没有 SPDIF 功放
         1) echo hdmi ;;
         3) echo lineout ;;
-        4) echo spdif ;;  # legacy dual -> spdif
-        *) echo spdif ;;
+        4) echo i2s ;;
+        5) echo i2s ;;
+        *) echo i2s ;;
     esac
 }
 
@@ -52,6 +54,11 @@ apply_route() {
     local pcm card
 
     case "$mode" in
+        i2s)
+            pcm="PlaybackI2S"
+            card="sndi2s1"
+            apply_analog_out 0
+            ;;
         spdif)
             pcm="PlaybackSPDIF"
             card="sndowa"
@@ -81,18 +88,18 @@ apply_route() {
 
 MODE="$1"
 case "$MODE" in
-    spdif|hdmi|lineout) ;;
+    i2s|spdif|hdmi|lineout) ;;
     show)
         usage
         exit 0
         ;;
     auto|"")
         MODE=$(resolve_mode_from_setting 2>/dev/null || cat "$MODE_FILE" 2>/dev/null)
-        [ -n "$MODE" ] || MODE=spdif
+        [ -n "$MODE" ] || MODE=i2s
         ;;
     dual)
-        echo "dual 已移除，改用 spdif"
-        MODE=spdif
+        echo "dual 已移除，改用 i2s"
+        MODE=i2s
         ;;
     *)
         echo "无效模式: $MODE"
