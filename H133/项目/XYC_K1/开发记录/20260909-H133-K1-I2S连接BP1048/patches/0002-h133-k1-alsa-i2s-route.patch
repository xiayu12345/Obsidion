     slave.channels 2
 }
@@ -33,7 +42,7 @@ pcm.CaptureDsnoop {
         ipc_perm 0666
         slave {
             pcm "hw:sndi2s1,0"
-            rate 48000
+            rate 44100
             channels 2
             format S16_LE
             period_size 1024
@@ -179,11 +188,12 @@ pcm.PlaybackHPOUT {
 # --- default route（audio_route.sh 改 playback.pcm 与 ctl card） ---
 ctl.!default {
     type hw
-    card sndowa
+    card sndi2s1
 }
 
 pcm.!default {
     type asym
-    playback.pcm "PlaybackSPDIF"
-    capture.pcm "CaptureAC107"
+    playback.pcm "PlaybackI2S"
+    /* K1 无 AC107；默认录音走片内 codec，避免和 I2S1 播放抢同一张卡 */
+    capture.pcm "Capture"
 }
