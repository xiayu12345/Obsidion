+static int desk_mcu_dsp1048_cmd(uint8_t cmd, const uint8_t *data, uint8_t dlen)
+{
+    uint8_t frame[12];
+    size_t n;
+    ssize_t w;
+
+    if (g_mcu_fd < 0) {
+        return -1;
+    }
+    if (dlen > 4U) {
+        return -1;
+    }
+
+    frame[0] = 0xAA;
+    frame[1] = 0xA6;
+    frame[2] = cmd;
+    frame[3] = dlen;
+    if (dlen > 0U && data != NULL) {
+        memcpy(&frame[4], data, dlen);
+    }
+    frame[4U + dlen] = 0xEF;
+    n = 5U + (size_t)dlen;
+
+    w = write(g_mcu_fd, frame, n);
+    if (!desk_mcu_is_dsp1048()) {
+        tcdrain(g_mcu_fd);
+    }
+    usleep(MCU_FRAME_GAP_US);
+    if (w != (ssize_t)n) {
+        DESK_LOG_M("desk_mcu", "dsp1048 write cmd=0x%02x failed", cmd);
+        return -1;
+    }
+    DESK_LOG_M("desk_mcu", "dsp1048 tx cmd=0x%02x dlen=%u", cmd, dlen);
+    return 0;
+}
