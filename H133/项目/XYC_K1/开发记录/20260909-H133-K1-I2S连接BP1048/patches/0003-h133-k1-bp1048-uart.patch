@@ -0,0 +1,302 @@
+#!/bin/sh
+# H133-K1: BP1048 UART（协议 20260908）
+# 波特率 1500000；安卓→DSP：AA A6 / AA 55 … EF
+#
+# ttyS3 由守护进程常开，不再 close（关串口会停 RX、下次 open 冲 FIFO）。
+# 发命令走 /tmp/dsp1048.cmd；收包写 /tmp/dsp1048.rx.bin。
+# 持续看：dsp1048.sh log
+#
+# 用法:
+#   dsp1048.sh boot              开机：拉起守护进程 + 解静音/音量
+#   dsp1048.sh aux|bt            切到 AUX/蓝牙输入
+#   dsp1048.sh unmute|mute
+#   dsp1048.sh vol <0-32>
+#   dsp1048.sh query             查版本（单条）
+#   dsp1048.sh log               持续打印 RX
+#   dsp1048.sh status            守护进程状态
+
+UART_DEV=${DSP1048_UART:-/dev/ttyS3}
+CMD_FIFO=/tmp/dsp1048.cmd
+RX_LOG=/tmp/dsp1048.rx.log
+RX_BIN=/tmp/dsp1048.rx.bin
+PID_FILE=/tmp/dsp1048.pid
+READY_FILE=/tmp/dsp1048.ready
+INIT_DONE=/tmp/dsp1048_init.done
+MCU_PARAMS_PATH=/usr/share/mix_station/参数.txt
+BAUD=1500000
+LOG_TAG="[dsp1048]"
+
+log() { echo "$LOG_TAG $*"; }
+
+gap() { usleep 80000 2>/dev/null || true; }
+
+daemon_alive() {
+	[ -f "$PID_FILE" ] || return 1
+	kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
+}
+
+# 清掉旧守护（含 RX/TX 子进程），避免双开抢 RX
+stop_daemon() {
+	if [ -f "$PID_FILE" ]; then
+		kill "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null || true
+	fi
+	ps | grep '[d]sp1048.sh _daemon' | awk '{print $1}' | while read -r p; do
+		kill -9 "$p" 2>/dev/null || true
+	done
+	ps | grep 'cat /tmp/dsp1048.cmd' | awk '{print $1}' | while read -r p; do
+		kill -9 "$p" 2>/dev/null || true
+	done
+	ps | grep 'cat /dev/ttyS3' | awk '{print $1}' | while read -r p; do
+		kill -9 "$p" 2>/dev/null || true
+	done
+	rm -f "$READY_FILE" "$PID_FILE"
+	usleep 200000 2>/dev/null || sleep 1
+}
+
+# 完整一帧一次 printf，避免 FIFO 上多 write 交错
+send_hex() {
+	fmt=""
+	for b in "$@"; do
+		fmt="${fmt}\\x$b"
+	done
+	if ! daemon_alive || [ ! -p "$CMD_FIFO" ]; then
+		log "error: daemon not running (need: dsp1048.sh boot)"
+		return 1
+	fi
+	printf "$fmt" > "$CMD_FIFO"
+}
+
+dump_rx() {
+	usleep 200000 2>/dev/null || sleep 1
+	if [ -f "$RX_BIN" ]; then
+		hexdump -v -C "$RX_BIN" | tail -n 12 | sed "s/^/$LOG_TAG rx /"
+	fi
+}
+
+# $1=vol 0~32 → AA A6 10 02 10 VOL EF
+send_vol() {
+	v=$1
+	[ "$v" -lt 0 ] 2>/dev/null && v=0
+	[ "$v" -gt 32 ] 2>/dev/null && v=32
+	send_hex aa a6 10 02 10 "$(printf '%02x' "$v")" ef
+}
+
+# AUX=2 BT=3 → AA A6 01 01 MODE EF
+send_mode() {
+	send_hex aa a6 01 01 "$(printf '%02x' "$1")" ef
+}
+
+# unmute=0 mute=1 → AA A6 02 01 X EF
+send_mute() {
+	send_hex aa a6 02 01 "$(printf '%02x' "$1")" ef
+}
+
+# AA 55 CMD EF
+send_query() {
+	send_hex aa 55 "$(printf '%02x' "$1")" ef
+}
+
+read_master_volume() {
+	vol=16
+	if [ -n "$DESK_MCU_VOLUME" ]; then
+		vol=$DESK_MCU_VOLUME
+	elif [ -f "$MCU_PARAMS_PATH" ]; then
+		v=$(grep -o '"master_volume"[[:space:]]*:[[:space:]]*[0-9][0-9]*' "$MCU_PARAMS_PATH" 2>/dev/null \
+			| head -1 | sed 's/.*:[[:space:]]*//')
+		[ -n "$v" ] && vol=$v
+	fi
+	if [ "$vol" -lt 0 ] 2>/dev/null; then vol=0; fi
+	if [ "$vol" -gt 32 ] 2>/dev/null; then vol=32; fi
+	echo "$vol"
+}
+
+wait_i2s() {
+	n=0
+	while [ $n -lt 20 ]; do
+		if grep -q sndi2s1 /proc/asound/cards 2>/dev/null; then
+			return 0
+		fi
+		n=$((n + 1))
+		sleep 1
+	done
+	log "warn: sndi2s1 not ready, continue"
+	return 1
+}
+
+rotate_rx_log() {
+	sz=$(wc -c < "$RX_BIN" 2>/dev/null || echo 0)
+	if [ "$sz" -gt 65536 ]; then
+		: > "$RX_BIN"
+	fi
+}
+
+# 常驻：RX 子进程一直占着 ttyS3；本 shell 不 exec 打开串口
+# （ash 把 stdout 重定向到 /dev/ttyS3 后不会改回来，日志会打到 DSP）
+cmd_daemon() {
+	trap '' HUP
+	trap 'rm -f "$READY_FILE" "$PID_FILE"; exit 0' TERM INT
+
+	echo $$ > "$PID_FILE"
+	rm -f "$CMD_FIFO" "$READY_FILE"
+	mkfifo -m 666 "$CMD_FIFO" || {
+		echo "$LOG_TAG error: mkfifo $CMD_FIFO" >&2
+		exit 1
+	}
+	: > "$RX_BIN"
+	chmod 666 "$RX_BIN" 2>/dev/null || true
+
+	[ -e "$UART_DEV" ] || { echo "$LOG_TAG error: $UART_DEV missing" >&2; exit 1; }
+
+	exec 0</dev/null
+	exec 1>>/tmp/dsp1048.daemon.log
+	exec 2>>/tmp/dsp1048.daemon.log
+
+	# cat 一直占着 UART；不要用 count=1 那种读完就 close
+	(
+		trap '' HUP
+		cat "$UART_DEV" >> "$RX_BIN"
+	) &
+	usleep 80000 2>/dev/null || true
+
+	stty -F "$UART_DEV" "$BAUD" cs8 -cstopb -parenb raw -echo -crtscts clocal cread min 1 time 0 2>/dev/null || {
+		log "error: stty $BAUD failed"
+		exit 1
+	}
+
+	(
+		trap '' HUP
+		while :; do
+			sleep 30
+			rotate_rx_log
+		done
+	) &
+
+	touch "$READY_FILE"
+	log "daemon tty=$UART_DEV baud=$BAUD (hold open)"
+
+	# dd 在子进程里打开串口，避免本 shell 的 stdout 被绑到 TX
+	while :; do
+		dd if="$CMD_FIFO" of="$UART_DEV" bs=256 2>/dev/null
+	done
+}
+
+start_daemon() {
+	if daemon_alive && [ -p "$CMD_FIFO" ] && [ -f "$READY_FILE" ]; then
+		return 0
+	fi
+	stop_daemon
+	self=$0
+	case "$self" in
+	/*) ;;
+	*) self=/usr/bin/dsp1048.sh ;;
+	esac
+	"$self" _daemon </dev/null >>/tmp/dsp1048.daemon.log 2>&1 &
+	n=0
+	while [ $n -lt 50 ]; do
+		if [ -f "$READY_FILE" ] && daemon_alive; then
+			return 0
+		fi
+		usleep 100000 2>/dev/null || sleep 1
+		n=$((n + 1))
+	done
+	log "error: daemon start timeout"
+	return 1
+}
+
+cmd_boot() {
+	wait_i2s
+	start_daemon || return 1
+
+	log "unmute"
+	send_mute 0
+	gap
+
+	vol=$(read_master_volume)
+	log "music volume $vol"
+	send_vol "$vol"
+	gap
+	dump_rx
+
+	touch "$INIT_DONE"
+	log "boot done vol=$vol (uart held by pid $(cat "$PID_FILE" 2>/dev/null))"
+}
+
+cmd_query() {
+	start_daemon || return 1
+	off=0
+	[ -f "$RX_BIN" ] && off=$(wc -c < "$RX_BIN")
+	log "query version"
+	send_query 236
+	usleep 200000 2>/dev/null || sleep 1
+	if [ -f "$RX_BIN" ]; then
+		tail -c +$((off + 1)) "$RX_BIN" 2>/dev/null | hexdump -v -C | sed "s/^/$LOG_TAG rx /"
+	fi
+}
+
+cmd_status() {
+	if daemon_alive; then
+		log "daemon pid=$(cat "$PID_FILE") ready=$([ -f "$READY_FILE" ] && echo yes || echo no)"
+		log "cmd $CMD_FIFO  rx $RX_BIN"
+		ls -l /dev/ttyS3 "$CMD_FIFO" "$RX_BIN" "$PID_FILE" 2>/dev/null
+	else
+		log "daemon not running"
+		return 1
+	fi
+}
+
+usage() {
+	echo "用法: dsp1048.sh boot|aux|bt|unmute|mute|vol <0-32>|query|log|status"
+}
+
+case "${1:-}" in
+_daemon)
+	cmd_daemon
+	;;
+boot)
+	cmd_boot
+	;;
+aux)
+	start_daemon && send_mode 2
+	;;
+bt)
+	start_daemon && send_mode 3
+	;;
+unmute)
+	start_daemon && send_mute 0
+	;;
+mute)
+	start_daemon && send_mute 1
+	;;
+vol)
+	[ -n "${2:-}" ] || { usage; exit 1; }
+	start_daemon && send_vol "$2"
+	;;
+query)
+	cmd_query
+	;;
+log)
+	start_daemon || exit 1
+	log "follow $RX_BIN (Ctrl-C 退出，不关串口)"
+	off=0
+	[ -f "$RX_BIN" ] && off=$(wc -c < "$RX_BIN")
+	while :; do
+		usleep 200000 2>/dev/null || sleep 1
+		[ -f "$RX_BIN" ] || continue
+		nsz=$(wc -c < "$RX_BIN")
+		if [ "$nsz" -lt "$off" ]; then
+			off=0
+		fi
+		if [ "$nsz" -gt "$off" ]; then
+			tail -c +$((off + 1)) "$RX_BIN" | hexdump -v -C
+			off=$nsz
+		fi
+	done
+	;;
+status)
+	cmd_status
+	;;
+*)
+	usage
+	exit 1
+	;;
+esac
diff --git a/openwrt/target/h133/h133-p1_nor_XYC_K1/busybox-init-base-files/etc/dsp1048.protocol b/openwrt/target/h133/h133-p1_nor_XYC_K1/busybox-init-base-files/etc/dsp1048.protocol
