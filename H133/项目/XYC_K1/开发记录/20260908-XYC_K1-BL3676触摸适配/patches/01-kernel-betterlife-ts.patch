+	if (ts) {
+		BTL_DEBUG("Suspend by i2c pm.");
+		btl_ts_suspend(ts);
+	}
+
+	return 0;
+}
+static int btl_pm_resume(struct device *dev)
+{
+	struct btl_ts_data *ts = g_btl_ts;
+
+	if (ts) {
+		BTL_DEBUG("Resume by i2c pm.");
+		btl_ts_resume(ts);
+	}
+
+	return 0;
+}
