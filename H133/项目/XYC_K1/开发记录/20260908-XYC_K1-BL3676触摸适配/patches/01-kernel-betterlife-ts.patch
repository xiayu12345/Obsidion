+#ifdef BTL_APK_SUPPORT
+static int btl_apk_open(struct inode* inode, struct file* file)
+{
+    struct btl_ts_data *ts = g_btl_ts;
+    ts->apk_data = kzalloc(10240, GFP_KERNEL);
+    if(ts->apk_data == NULL) {
+        BTL_DEBUG("btl can't allocate memory for apk\n");
+        return -1;
+    }
+    ts->apk_mode = 1;
+	BTL_DEBUG_FUNC();
+    return 0;
+}
+
+static int btl_apk_close(struct inode* inode, struct file* file)
+{
+    struct btl_ts_data *ts = g_btl_ts;
+    if(ts->apk_data != NULL) {
+        kfree(ts->apk_data);
+    }
+    ts->apk_mode = 0;
+	BTL_DEBUG_FUNC();
+    return 0;
+}
+
+static ssize_t btl_apk_write(struct file* file, const char __user* buff, size_t count, loff_t* offp)
+{
+
+    int ret = 0;
+	unsigned char cmd = 0;
+    unsigned short wSize = 0, rSize = 0;
+	unsigned char cmdArg = 0;
+    struct btl_ts_data *ts = g_btl_ts;
+    if(copy_from_user(ts->apk_data, buff, count)) {
+        return -EFAULT;
+    }
+
+    cmd = ts->apk_data[0];
+    wSize = ts->apk_data[1] + (ts->apk_data[2] << 8);
+    if(cmd == CMD_READ_DATA)
+    {
+        rSize = ts->apk_data[4 + wSize] + (ts->apk_data[5 + wSize] << 8);
+    }
+    cmdArg = ts->apk_data[3];
+	
+    BTL_DEBUG("%s:count = %d cmd = %x wSize = %x cmdArg = %x rsize = %x\n", __func__, count, cmd, wSize, cmdArg, rSize);
+    switch(cmd) 
+    {
+        case CMD_WRITE_DATA:
+            btl_i2c_lock();
+            ret = btl_i2c_write(ts->client, cmdArg, &ts->apk_data[4], wSize);
+            btl_i2c_unlock();
+            
+            
+            if(ret < 0) 
+            {
+                BTL_ERROR(" btl ___%s:i2c transfer error___\n", __func__);
+                return -1;
+            }
+            break;
+			
+		case CMD_READ_DATA: 
+			btl_i2c_lock();
+			ret = btl_i2c_write_read(ts->client, cmdArg, &ts->apk_data[4], wSize, &ts->apk_data[0], rSize);
+			btl_i2c_unlock();
+		
+			if(ret < 0) 
+			{
+				BTL_ERROR("btl ___%s %d:i2c transfer \n", __func__, __LINE__);
+				return -1;
+			}
+			break;
+        #if defined(BTL_ESD_PROTECT_SUPPORT)
+        case CMD_ESD_SWITCH: 
+            if(cmdArg) 
+            {
+                btl_esd_switch(ts, SWITCH_ON);
+            } 
+            else 
+            {
+                btl_esd_switch(ts, SWITCH_OFF);
+            }
+            break;
+        #endif
+        #if defined(BTL_CHARGE_PROTECT_SUPPORT)
+        case CMD_CHARGE_SWITCH :
+            if(cmdArg) 
+            {
+                btl_charge_switch(ts, SWITCH_ON);
+            } 
+			else 
+            {
+                btl_charge_switch(ts, SWITCH_OFF);
+            }
+            break;
+        #endif
+
+		case CMD_IRQ_SWITCH :
+			if(cmdArg) 
+			{
+				btl_irq_enable(ts);
+			} 
+			else 
+			{
+				btl_irq_disable(ts);
+			}
+			break;
+
+		case CMD_RST_SET_VALUE: 
+			if(cmdArg) 
+			{
+				BTL_GPIO_OUTPUT(ts->reset_gpio_number, 1);
+				ts->reset_gpio_level = 1;
+			} 
+			else 
+			{
+				BTL_GPIO_OUTPUT(ts->reset_gpio_number, 0);
+				ts->reset_gpio_level = 0;
+			}
+			break;
+
+		case CMD_INT_SET_VALUE: 
+			if(cmdArg) 
+			{
+				BTL_GPIO_OUTPUT(ts->irq_gpio_number, 1);
+				ts->irq_gpio_level = 1;
+				ts->irq_gpio_dir = 0;
+			} 
+			else 
+			{
+				BTL_GPIO_OUTPUT(ts->irq_gpio_number, 0);
+				ts->irq_gpio_level = 0;
+				ts->irq_gpio_dir = 0;
+			}
+			break;
+
+		case CMD_INT_SET_DIR : 
+			if(cmdArg) 
+			{
+				BTL_GPIO_AS_INPUT(ts->irq_gpio_number);
+				ts->irq_gpio_dir = 1;
+			} 
+			else 
+			{
+				BTL_GPIO_OUTPUT(ts->irq_gpio_number, 1);
+				ts->irq_gpio_level = 1;
+				ts->irq_gpio_dir = 0;
+			}
+			break;
+
+        case CMD_GET_CHIPID: 
+            ts->apk_data[0] = ts->chipInfo.chipID;
+            break;
+
+        case CMD_CLEAR_DATA:
+            memset(ts->apk_data, 0, 10240);
+            break;
+			
+		case CMD_GET_DEVICE_ADDRESS:
+			ts->apk_data[0] = CTP_SLAVE_ADDR;
+			break;
+        #if defined(BTL_DEBUG_SUPPORT)
+		case CMD_LOG_SWITCH:
+			if(cmdArg) 
+            {
+				LogEn = 1;
+            } 
+			else 
+            {
+                LogEn = 0;
+            }
+            break;
+        #endif
+        default : 
+            return -1;
+    }
+        
+    return count;
+}
+
+
+static ssize_t btl_apk_read(struct file* file, char __user* buff, size_t count, loff_t* offp)
+{
+    struct btl_ts_data *ts = g_btl_ts;
+	BTL_DEBUG("%s:val = %x len = %x\n", __func__, ts->apk_data[0], count);
+    if(copy_to_user(buff, &ts->apk_data[0], count)) {
+        return -EFAULT;
+    }
+    return count;
+}
