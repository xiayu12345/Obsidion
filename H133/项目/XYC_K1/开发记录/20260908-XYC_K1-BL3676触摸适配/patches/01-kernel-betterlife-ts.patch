+            BTL_DEBUG("started");
+            queue_delayed_work(ts->btl_assist_wq, &ts->charge_work, ts->clk_tick_cnt_charge);
+        } else {
+            spin_unlock(&ts->charge_lock);
+        }
+
+    } else {
+        if(ts->charge_running) {
+            ts->charge_running = 0;
+            spin_unlock(&ts->charge_lock);
+            BTL_DEBUG("cancelled");
+            cancel_delayed_work_sync(&ts->charge_work);
