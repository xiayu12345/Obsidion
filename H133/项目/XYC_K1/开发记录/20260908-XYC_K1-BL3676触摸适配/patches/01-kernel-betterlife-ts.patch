+static int btl_debugfs_malloc_free_data(struct btl_ts_data *ts, bool allocate)
+{
+    if (true == allocate) {
+        ts->data = vmalloc(DATA_BUFFER_LEN);
+        if (NULL == ts->data) {
+            BTL_ERROR("ts->testresult malloc fail\n");
+            return -ENOMEM;
+        }
+        ts->datalen = 0;
+    } else {
+        if (ts->data) {
+            vfree(ts->data);
+            ts->data = NULL;
+        }
+    }
+    return 0;
+}
+
+static int btl_debugfs_clear_data(struct btl_ts_data *ts)
+{
+    if (ts->data) {
+        ts->datalen = 0;
+    }
+    return 0;
+}
