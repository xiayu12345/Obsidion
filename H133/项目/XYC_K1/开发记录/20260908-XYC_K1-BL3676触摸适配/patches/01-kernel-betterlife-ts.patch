+        BTL_DEBUG("request firmware %s success", BTL_REQUEST_FIRMWARE_BIN_PATH);
+        fwData = vmalloc(fw->size);
+        if (NULL == fwData) {
+            BTL_DEBUG("fwData buffer vmalloc fail");
