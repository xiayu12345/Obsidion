+#if defined(BTL_SUSPEND_MODE)
+static int btl_i2c_test(void)
+{
+    int ret = 0;
+    unsigned char testCmd = 0x01;
+	ret = btl_i2c_write(g_btl_ts->client, CTP_SLAVE_ADDR, &testCmd, 1);
+	return ret;
+}
