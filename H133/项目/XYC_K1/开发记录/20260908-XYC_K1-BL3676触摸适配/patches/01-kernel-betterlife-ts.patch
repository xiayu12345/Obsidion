+
+	ts->ps_input_dev = input_allocate_device();
+	if (ts->ps_input_dev == NULL) {
+		ret = -ENOMEM;
+		BTL_DEBUG("btl error::failed to allocate ps-input device\n");
+		goto exit_input_allocate_device_failed;
