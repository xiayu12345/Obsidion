+			btl_ts_resume(ts);
+		}
+		else if(adf_event_data == DRM_MODE_DPMS_OFF)
+		{
+		    BTL_DEBUG("Suspend by adf notifier.");
+			btl_ts_suspend(ts);
+		}
+	}
+	return 0;
+}
