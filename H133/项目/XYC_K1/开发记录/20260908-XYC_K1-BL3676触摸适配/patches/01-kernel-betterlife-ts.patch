+static int btl_get_checksum_with_read_firmware(unsigned short *fw_checksum)
+{
+    int ret = 0;
+    int i = 0;
+    int j = 0;
+	int package_size = 0;
+	int remainder_size = MAX_FLASH_SIZE;
+	unsigned char buf[FLASH_RSIZE] = {0x00};
+    unsigned short checkSum = 0x00;
+	SET_WAKEUP_LOW;
+	for(i = 0; i < MAX_FLASH_SIZE;) {
+        remainder_size = MAX_FLASH_SIZE - i;
+        if(remainder_size > FLASH_RSIZE) {
+            package_size = FLASH_RSIZE;
+        } else {
+            package_size = remainder_size;
+        }
+        if(btl_read_flash(READ_MAIN_CMD, i, buf, package_size) < 0) {
+			BTL_DEBUG("bl_check_firmware_valid:read firmware error\r\n");
+            ret = -1;
+            goto err;
+        } else {
+            for(j = 0; j < package_size; j++) {
+                checkSum += buf[j];
+            }
+        }
+		i += package_size;
+    }
+    
+err:
+    SET_WAKEUP_HIGH;
+	*fw_checksum = checkSum & 0xffff;
+	BTL_DEBUG("bl_check_firmware_valid:fw_checksum is 0x%x\r\n", *fw_checksum);
+	return ret;
+}
