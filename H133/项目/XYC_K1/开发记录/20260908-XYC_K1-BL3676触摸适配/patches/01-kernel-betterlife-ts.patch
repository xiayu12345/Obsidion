+static struct file_operations btl_ps_fops = {
+	.owner	= THIS_MODULE,
+	.open	= btl_ps_open,
+	.release	= btl_ps_release,
+	.unlocked_ioctl	= btl_ps_ioctl,
+};
+static struct miscdevice btl_ps_device = {
