+#!/bin/sh
+# Stop LVGL UI + watchdog daemons for touch debugging (getevent / i2cdetect).
+
+stop_ui() {
+	killall lv_tp_daemon.sh lv_daemon.sh 2>/dev/null
+	killall lv_tp_test sing_ktv 2>/dev/null
+	sleep 1
+	killall -9 lv_tp_daemon.sh lv_daemon.sh 2>/dev/null
+	killall -9 lv_tp_test sing_ktv 2>/dev/null
+	for p in $(ps | grep -E 'lv_tp_daemon|lv_daemon\.sh' | grep -v grep | awk '{print $1}'); do
+		kill -9 "$p" 2>/dev/null
+	done
+}
+
+case "$1" in
+stop)
+	stop_ui
+	echo "UI stopped. Example: getevent /dev/input/event3"
+	;;
+start-test)
+	stop_ui
+	lv_tp_test "${2:-3}" &
+	;;
+start-desktop|start-projector|projector)
+	stop_ui
+	sing_ktv "${2:-3}" &
+	/usr/bin/lv_daemon.sh &
+	;;
+watch|*)
+	TP_DEV="${1:-/dev/input/event3}"
+	stop_ui
+	echo "Touch device (from /proc/bus/input/devices):"
+	grep -A6 -E 'gt9xx|gt911' /proc/bus/input/devices 2>/dev/null
+	echo "Watching ${TP_DEV} (Ctrl+C to stop)..."
+	getevent "$TP_DEV"
+	;;
+esac
