@@ -0,0 +1,63 @@
+#!/bin/sh
+# SD 卡由 lv_projector DiskManager 管理，此处仅处理 USB
+
+if [ "${ACTION}" == "remove" ]; then
+    MOUNTPOINT="$(grep -w "^/dev/${MDEV}" /proc/mounts | awk '{print $2}')"
+    [ -n "${MOUNTPOINT}" ] \
+        && /bin/umount -l ${MOUNTPOINT} 2>/dev/null
+    case "${MOUNTPOINT}" in
+        /tmp/USB*)
+            rm -rf ${MOUNTPOINT} 2>/dev/null
+            ;;
+    esac
+
+    USB_COUNT="$(grep "/tmp/USB" /proc/mounts | busybox wc -l)"
+    if [ ${USB_COUNT} -eq 0 ]; then
+        rm -f /tmp/usb_mount_ok
+        rm -rf /tmp/USB* 2>/dev/null
+    fi
+    exit 0
+fi
+
+if [ "${ACTION}" == "add" ]; then
+    case ${MDEV} in
+        sd[a-z])
+            [ -d "/sys/block/${MDEV}/${MDEV}1" ] && exit 0
+            MOUNTPOINT=NULL
+            for i in 0 1 2 3 4 5 6 7
+            do
+                if [ -d "/tmp/USB${i}" ]; then
+                    continue
+                fi
+                MOUNTPOINT=/tmp/USB${i}
+                break
+			done
+            ;;
+        sd[a-z][0-9])
+            MOUNTPOINT=NULL
+            for i in 0 1 2 3 4 5 6 7
+            do
+                if [ -d "/tmp/USB${i}" ]; then
+                    continue
+                fi
+                MOUNTPOINT=/tmp/USB${i}
+                break
+            done
+            ;;
+        *)
+            exit 0
+            ;;
+    esac
+
+    if [ ${MOUNTPOINT} != "NULL" ]; then
+        mkdir -p ${MOUNTPOINT}
+        for fstype in vfat exfat ntfs-3g ext4
+        do
+            [ "${fstype}" = "ext4" -a -x "/usr/sbin/e2fsck" ] \
+                && e2fsck -p /dev/${MDEV} >/dev/null
+            /bin/mount -t ${fstype} -o utf8 /dev/${MDEV} ${MOUNTPOINT} \
+                && touch /tmp/usb_mount_ok && exit 0
+        done
+    fi
+fi
+exit 0
