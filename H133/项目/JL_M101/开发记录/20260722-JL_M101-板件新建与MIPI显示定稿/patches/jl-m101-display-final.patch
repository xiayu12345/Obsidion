+static void LCD_panel_init(u32 sel)
+{
+	u32 i;
+	u8 cmd;
+	u32 count;
+	u8 *para;
+
+	pr_info("jl_m101_jd9365da: panel_init\n");
+	sunxi_lcd_dsi_clk_enable(sel);
+	sunxi_lcd_delay_ms(20);
+	/* 厂商流程：硬 reset 后直接发页命令，无 soft reset。
+	 * 不做 DSI 读探针：LP 读会触发 BTA，屏不回时把 DPHY 卡在读态，
+	 * 随后 dsi_gen_wr 的 while(dsi_inst_busy) 无超时会死等（de_dsi.c）。 */
+
+	for (i = 0; ; i++) {
+		cmd = lcm_initialization_setting[i].cmd;
+		count = lcm_initialization_setting[i].count;
+		para = lcm_initialization_setting[i].para_list;
+		if (cmd == REGFLAG_END_OF_TABLE)
+			break;
+		if (cmd == REGFLAG_DELAY) {
+			sunxi_lcd_delay_ms(count);
+			continue;
+		}
+		/* 厂商表和同系 JD9366 驱动均按 GEN 写入，0x11/0x29 不另转 DCS。 */
+		dsi_gen_wr(sel, cmd, para, count);
+	}
+}
+
+static void LCD_panel_exit(u32 sel)
+{
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x28);
+	sunxi_lcd_delay_ms(20);
+	sunxi_lcd_dsi_dcs_write_0para(sel, 0x10);
+	sunxi_lcd_delay_ms(80);
+}
+
+static s32 LCD_user_defined_func(u32 sel, u32 para1, u32 para2, u32 para3)
+{
+	(void)sel;
+	(void)para1;
+	(void)para2;
+	(void)para3;
+	return 0;
+}
