+&gpadc {
+	channel_num = <1>;
+	channel_select = <1>;
+	channel_data_select = <1>;
+	channel_compare_select = <1>;
+	channel_cld_select = <1>;
+	channel_chd_select = <1>;
+	channel0_compare_lowdata = <1700000>;
+	channel0_compare_higdata = <1200000>;
+	key_cnt = <5>;
+	key0_vol = <210>;
+	key0_val = <115>;
+	key1_vol = <410>;
+	key1_val = <114>;
+	key2_vol = <590>;
+	key2_val = <139>;
+	key3_vol = <750>;
+	key3_val = <28>;
+	key4_vol = <880>;
+	key4_val = <240>;
+	status = "okay";
+};
+
+&rtp {
+	allwinner,tp-sensitive-adjust = <0xf>;
+	allwinner,filter-type = <0x1>;
+	allwinner,ts-attached;
+	status = "disabled";
+};
