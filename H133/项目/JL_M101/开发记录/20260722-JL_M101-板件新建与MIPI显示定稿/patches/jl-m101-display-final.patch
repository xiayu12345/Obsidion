+#!/bin/sh
+
+function lv_daemon()
+{
+    local pid=99999
+    sleep 8s
+
+    while true
+    do
+        # 1: find protocol_TTL exit
+        pid=`ps | grep desk | grep -v "grep" | awk 'NR==1{print $1}'`
+        name=`ps | grep desk | grep -v "grep" | awk 'NR==1{print $5}'`
+        if [ ${pid} ] && [ $name == "desk" ]; then
+            sleep 3s
+        else
+            # 1: kill wifi
+            pid=`ps | grep "wpa_supplicant -iwlan0 -Dnl80211 -c /e" | grep -v "grep" | awk 'NR==1{print $1}'`
+            if [ ${pid} ]; then
+                echo "kill: wpa_supplicant! pid $pid"
+                kill -9 ${pid}
+            fi
+
+            # 2: kill bluetooth
+            pid=`ps | grep "bluealsa -p a2dp-source" | grep -v "grep" | awk 'NR==1{print $1}'`
+            if [ ${pid} ]; then
+                echo "kill: bluealsa! pid $pid"
+                kill -9 ${pid}
+            fi
+
+            pid=`ps | grep "/usr/bin/bluetoothd -n" | grep -v "grep" | awk 'NR==1{print $1}'`
+            if [ ${pid} ]; then
+                echo "kill: bluetoothd! pid $pid"
+                kill -9 ${pid}
+            fi
+
+            # 3: restart desk
+            desk &
+            echo "run desk!"
+            sleep 5s
+        fi
+    done
+    echo "kill over!"
+}
+
+lv_daemon
