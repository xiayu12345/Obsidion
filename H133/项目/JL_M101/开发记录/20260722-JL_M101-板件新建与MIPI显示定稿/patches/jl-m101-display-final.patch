+#!/bin/sh
+# ALSA playback route: spdif | hdmi
+# UI mapping: Speaker(0)->spdif, ARC(1)->hdmi
+
+ASOUND="/etc/asound.conf"
+MODE_FILE="/etc/audio_output.mode"
+
+usage() {
+    echo "用法: audio_route.sh spdif|hdmi|auto|show"
+    echo "当前: $(cat "$MODE_FILE" 2>/dev/null || echo unknown)"
+}
+
+resolve_mode_from_setting() {
+    local so
+
+    [ -f /mnt/UDISK/setting.ini ] || return 1
+    so=$(grep -E '^sound_output[[:space:]]*=' /mnt/UDISK/setting.ini | tail -1 | sed 's/.*=[[:space:]]*//')
+    case "$so" in
+        0) echo spdif ;;
+        1) echo hdmi ;;
+        4) echo spdif ;;  # legacy dual -> spdif
+        *) echo spdif ;;
+    esac
+}
+
+apply_route() {
+    local mode="$1"
+    local pcm card
+
+    case "$mode" in
+        spdif)
+            pcm="PlaybackSPDIF"
+            card="sndowa"
+            ;;
+        hdmi)
+            pcm="PlaybackHDMI"
+            card="sndi2s2"
+            ;;
+        *)
+            return 1
+            ;;
+    esac
+
+    [ -f "$ASOUND" ] || { echo "缺少 $ASOUND"; return 1; }
+
+    sed -i "s/^[[:space:]]*playback\\.pcm \"Playback[^\"]*\"/    playback.pcm \"$pcm\"/" "$ASOUND"
+    sed -i "/^ctl\\.!default {/,/^}/ s/^[[:space:]]*card .*/    card $card/" "$ASOUND"
+    return 0
+}
+
+MODE="$1"
+case "$MODE" in
+    spdif|hdmi) ;;
+    show)
+        usage
+        exit 0
+        ;;
+    auto|"")
+        MODE=$(resolve_mode_from_setting 2>/dev/null || cat "$MODE_FILE" 2>/dev/null)
+        [ -n "$MODE" ] || MODE=spdif
+        ;;
+    dual)
+        echo "dual 已移除，改用 spdif"
+        MODE=spdif
+        ;;
+    *)
+        echo "无效模式: $MODE"
+        usage
+        exit 1
+        ;;
+esac
+
+apply_route "$MODE" || exit 1
+
+echo "$MODE" > "$MODE_FILE"
+[ -d /mnt/UDISK ] && echo "$MODE" > /mnt/UDISK/audio_output.mode 2>/dev/null
+
+echo "audio route -> $MODE (ALSA default -> $ASOUND)"
+killall aplay 2>/dev/null
+exit 0
