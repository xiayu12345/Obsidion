@@ -0,0 +1,42 @@
+#!/bin/sh
+
+wifi_type="8733bu"
+version=$(awk '{print $3}' /proc/version)
+modulespath="/lib/modules/$version"
+
+# 若 uname 目录下没有，再扫 /lib/modules/*/8733bu.ko（防版本目录不一致）
+resolve_module() {
+	if [ -f "$modulespath/$1.ko" ]; then
+		echo "$modulespath/$1.ko"
+		return 0
+	fi
+	found=$(ls /lib/modules/*/"$1.ko" 2>/dev/null | head -n1)
+	if [ -n "$found" ]; then
+		echo "$found"
+		return 0
+	fi
+	return 1
+}
+
+load_module() {
+	module_path=$(resolve_module "$1")
+	if [ -z "$module_path" ]; then
+		echo "Failed to find module: $1.ko under /lib/modules/"
+		exit 1
+	fi
+	/sbin/insmod "$module_path"
+	if [ $? -ne 0 ]; then
+		echo "Failed to load module: $1 ($module_path)"
+		exit 1
+	fi
+}
+
+if lsmod | grep -q "^${wifi_type}"; then
+	echo "WiFi module ${wifi_type} already loaded."
+	exit 0
+fi
+
+load_module "${wifi_type}"
+
+echo "Modules loaded successfully."
+exit 0
