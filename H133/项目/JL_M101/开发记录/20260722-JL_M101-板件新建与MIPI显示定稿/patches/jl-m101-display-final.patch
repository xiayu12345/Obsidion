@@ -0,0 +1,29 @@
+#!/bin/sh
+
+
+# Stop all init scripts in /etc/init.d
+# executing them in reversed numerical order.
+#
+/etc/init.d/S01app stop
+
+for i in $(ls -r /etc/init.d/S??*) ;do
+
+     # Ignore dangling symlinks (if any).
+     [ ! -f "$i" ] && continue
+
+     case "$i" in
+	*.sh)
+	    # Source shell script for speed.
+	    (
+		trap - INT QUIT TSTP
+		set stop
+		. $i
+	    )
+	    ;;
+	*)
+	    # No sh extension, so fork subprocess.
+	    $i stop
+	    ;;
+    esac
+done
+
diff --git a/openwrt/target/h133/h133-p1_nor_JL_M101/busybox-init-base-files/etc/init.d/wifi_autoconnect b/openwrt/target/h133/h133-p1_nor_JL_M101/busybox-init-base-files/etc/init.d/wifi_autoconnect
new file mode 100755
index 000000000..8f8f2dac3
--- /dev/null
+++ b/openwrt/target/h133/h133-p1_nor_JL_M101/busybox-init-base-files/etc/init.d/wifi_autoconnect
@@ -0,0 +1,144 @@
+#!/bin/sh
+
+CONF=/etc/wifi/wifi_autoconnect.conf
+WPA_CONF=/etc/wifi/wpa_supplicant/wpa_supplicant.conf
+WPA_CTRL=/etc/wifi/wpa_supplicant/sockets
+IFACE=wlan0
+LOG_TAG=wifi_autoconnect
+
+log_msg() {
+	echo "$LOG_TAG: $*"
+}
+
+load_conf() {
+	WIFI_AUTO_ENABLE=0
+	WIFI_SSID=""
+	WIFI_PSK=""
+	if [ -f "$CONF" ]; then
+		# shellcheck disable=SC1090
+		. "$CONF"
+	fi
+}
+
+wait_iface() {
+	local i=0
+	while [ $i -lt 30 ]; do
+		if [ -d "/sys/class/net/$IFACE" ]; then
+			return 0
+		fi
+		sleep 1
+		i=$((i + 1))
+	done
+	return 1
+}
+
+wait_wpa_completed() {
+	local i=0
+	local state=""
+	while [ $i -lt 60 ]; do
+		state=$(wpa_cli -p "$WPA_CTRL" -i "$IFACE" status 2>/dev/null | awk -F= '/^wpa_state=/{print $2}')
+		if [ "$state" = "COMPLETED" ]; then
+			return 0
+		fi
+		sleep 1
+		i=$((i + 1))
+	done
+	return 1
+}
+
+ensure_writable_ctrl_dir() {
+	mkdir -p "$WPA_CTRL" 2>/dev/null
+	if touch "$WPA_CTRL/.write_probe" 2>/dev/null; then
+		rm -f "$WPA_CTRL/.write_probe"
+		return 0
+	fi
+	umount "$WPA_CTRL" 2>/dev/null
+	mount -t tmpfs tmpfs "$WPA_CTRL" -o mode=0755
+}
+
+write_wpa_conf() {
+	mkdir -p "$(dirname "$WPA_CONF")"
+	ensure_writable_ctrl_dir
+	cat > "$WPA_CONF" <<EOF
+disable_scan_offload=1
+update_config=1
+ctrl_interface=$WPA_CTRL
+
+network={
+    ssid="$WIFI_SSID"
+    psk="$WIFI_PSK"
+    key_mgmt=WPA-PSK
+}
+EOF
+}
+
+stop_wifi() {
+	killall udhcpc 2>/dev/null
+	wpa_cli -p "$WPA_CTRL" -i "$IFACE" terminate 2>/dev/null
+	killall wpa_supplicant 2>/dev/null
+	sleep 1
+}
+
+start_wifi() {
+	load_conf
+
+	if [ "$WIFI_AUTO_ENABLE" != "1" ]; then
+		log_msg "disabled (WIFI_AUTO_ENABLE=$WIFI_AUTO_ENABLE)"
+		return 0
+	fi
+
+	if [ -z "$WIFI_SSID" ] || [ -z "$WIFI_PSK" ]; then
+		log_msg "missing SSID or PSK in $CONF"
+		return 1
+	fi
+
+	if ! lsmod | grep -q "^8733bu"; then
+		if ! /etc/wifi/load_wifi_modules.sh; then
+			log_msg "load_wifi_modules failed"
+			return 1
+		fi
+	fi
+
+	if ! wait_iface; then
+		log_msg "timeout waiting for $IFACE"
+		return 1
+	fi
+
+	ifconfig "$IFACE" up 2>/dev/null
+
+	stop_wifi
+	write_wpa_conf
+
+	if ! wpa_supplicant -B -i "$IFACE" -D nl80211 -c "$WPA_CONF"; then
+		log_msg "wpa_supplicant start failed"
+		return 1
+	fi
+
+	sleep 2
+
+	if ! wait_wpa_completed; then
+		log_msg "failed to connect ssid=$WIFI_SSID"
+		return 1
+	fi
+
+	udhcpc -i "$IFACE" -s /etc/wifi/wmg_udhcpc.script -q -b
+	log_msg "connected ssid=$WIFI_SSID"
+	return 0
+}
+
+case "$1" in
+boot|start)
+	start_wifi &
+	;;
+stop)
+	stop_wifi
+	;;
+restart)
+	stop_wifi
+	start_wifi
+	;;
+*)
+	echo "usage: $0 {boot|start|stop|restart}"
+	exit 1
+	;;
+esac
