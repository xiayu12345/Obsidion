index 000000000..92c78b085
--- /dev/null
+++ b/openwrt/target/h133/h133-p1_nor_JL_M101/swupdate/sw-description-ubi
@@ -0,0 +1,123 @@
+software =
+{
+    version = "0.1.0";
+    description = "Firmware update for Tina Project";
+
+    stable = {
+
+        /* upgrade recovery,uboot,boot0 ==> change swu_mode,boot_partition ==> reboot */
+        upgrade_recovery = {
+            /* upgrade recovery */
+            images: (
+                {
+                    filename = "recovery";
+                    volume = "recovery"
+                    sha256 = "@recovery"
+                    installed-directly = true;
+                },
+                {
+                    filename = "uboot";
+                    type = "awuboot";
+                    sha256 = "@uboot"
+                },
+                {
+                    filename = "boot0";
+                    type = "awboot0";
+                    sha256 = "@boot0"
+                }
+            );
+            /* change swu_mode to upgrade_kernel,boot_partition to recovery & reboot*/
+            bootenv: (
+                {
+                    name = "swu_mode";
+                    value = "upgrade_kernel";
+                },
+                {
+                    name = "boot_partition";
+                    value = "recovery";
+                },
+                {
+                    name = "swu_next";
+                    value = "reboot";
+                }
+            );
+        };
+
+        /* upgrade kernel,rootfs ==> change sw_mode */
+        upgrade_kernel = {
+            /* upgrade kernel,rootfs */
+            images: (
+                {
+                    filename = "kernel";
+                    volume = "boot"
+                    sha256 = "@kernel"
+                    installed-directly = true;
+                },
+                {
+                    filename = "rootfs";
+                    volume = "rootfs"
+                    sha256 = "@rootfs"
+                    installed-directly = true;
+                }
+            );
+            /* change sw_mode to upgrade_usr,change boot_partition to boot */
+            bootenv: (
+                {
+                    name = "swu_mode";
+                    value = "upgrade_usr";
+                },
+                {
+                    name = "boot_partition";
+                    value = "boot";
+                }
+            );
+        };
+
+        /* upgrade usr ==> clean ==> reboot */
+        upgrade_usr = {
+            /* upgrade usr */
+
+            /* clean swu_param,swu_software,swu_mode & reboot */
+            bootenv: (
+                {
+                    name = "swu_param";
+                    value = "";
+                },
+                {
+                    name = "swu_software";
+                    value = "";
+                },
+                {
