index 000000000..d829c0e4a
--- /dev/null
+++ b/openwrt/target/h133/h133-p1_nor_JL_M101/busybox-init-base-files/usr/bin/ac107_collect_log.sh
@@ -0,0 +1,110 @@
+#!/bin/sh
+# TP-H10 AC107 诊断日志一键采集（发给方案商/硬件同事）
+# 用法: ac107_collect_log.sh [输出目录]
+# 默认输出: /mnt/SDCARD/luyin/ac107_diag_YYYYMMDD_HHMMSS.txt
+
+OUT_DIR="${1:-/mnt/SDCARD/luyin}"
+STAMP=$(date +%Y%m%d_%H%M%S)
+OUT="$OUT_DIR/ac107_diag_${STAMP}.txt"
+
+mkdir -p "$OUT_DIR" 2>/dev/null || OUT_DIR="/tmp"
+
+if [ "$OUT_DIR" = "/tmp" ]; then
+	OUT="/tmp/ac107_diag_${STAMP}.txt"
+fi
+
+section() {
+	echo "" >> "$OUT"
+	echo "========== $1 ==========" >> "$OUT"
+	echo "" >> "$OUT"
+}
+
+run() {
+	echo "\$ $*" >> "$OUT"
+	"$@" >> "$OUT" 2>&1 || echo "[exit $?]" >> "$OUT"
+	echo "" >> "$OUT"
+}
+
+: > "$OUT"
+
+section "基本信息"
+echo "采集时间: $(date)" >> "$OUT"
+run uname -a
+run cat /etc/openwrt_release
+run cat /proc/device-tree/model
+
+section "声卡列表"
+run cat /proc/asound/cards
+run aplay -l
+run arecord -l
+
+section "I2C 设备节点"
+run ls -l /dev/i2c-*
+
+section "I2C 扫描 TWI1 (触摸 GT911, 期望 0x5d)"
+run i2cdetect -y 1
+
+section "I2C 扫描 TWI2 (AC107, 期望 0x36)"
+run i2cdetect -y 2
+
+section "内核日志 AC107/I2S/TWI"
+run dmesg
+echo "--- filtered ---" >> "$OUT"
+dmesg 2>/dev/null | grep -iE 'twi|ac107|sndi2s|simple_parse|2502800' >> "$OUT" 2>&1 || true
+echo "" >> "$OUT"
+
+section "I2C 设备 sysfs"
+run ls /sys/bus/i2c/devices/
+run ls -l /sys/bus/i2c/devices/ 2>/dev/null
+if [ -d /sys/bus/i2c/devices/2-0036 ]; then
+	run cat /sys/bus/i2c/devices/2-0036/name
+else
+	echo "2-0036 不存在（AC107 probe 未成功）" >> "$OUT"
+	echo "" >> "$OUT"
+fi
+
+section "ALSA 默认配置"
+run grep -A8 'pcm.!default' /etc/asound.conf
+run grep -A6 'CaptureAC107' /etc/asound.conf
+
+section "UART3 / MCU"
+run ls -l /dev/ttyS3
+run stty -F /dev/ttyS3 -a
+
+section "电源 regulator (ac107)"
+if [ -r /sys/kernel/debug/regulator/regulator_summary ]; then
+	run grep -i ac107 /sys/kernel/debug/regulator/regulator_summary
+else
+	echo "regulator_summary 不可用（需 debugfs）" >> "$OUT"
+	echo "" >> "$OUT"
+fi
+
+section "可选: MCU 内录 + 短录音 (5s)"
+if [ -e /dev/ttyS3 ]; then
+	stty -F /dev/ttyS3 115200 cs8 -cstopb -parenb raw -echo 2>/dev/null
+	printf '\xAF\x55\x05\x01\x01\x02\x0C\x0B' > /dev/ttyS3 2>/dev/null
+	sleep 0.1
+	printf '\xAF\x55\x05\x01\x01\x02\x0A\x0D' > /dev/ttyS3 2>/dev/null
+	sleep 0.1
+	WAV="$OUT_DIR/ac107_proof_${STAMP}.wav"
+	echo "录音文件: $WAV" >> "$OUT"
+	if arecord -q -D CaptureAC107 -f S16_LE -r 48000 -c 2 -d 3 "$WAV" 2>>"$OUT"; then
+		ls -l "$WAV" >> "$OUT" 2>&1
+	else
+		echo "arecord 失败（可能 sndi2s1 未注册）" >> "$OUT"
+	fi
+	printf '\xAF\x55\x05\x01\x01\x02\x0B\x0E' > /dev/ttyS3 2>/dev/null
+	echo "" >> "$OUT"
+else
+	echo "/dev/ttyS3 不存在，跳过 MCU/录音" >> "$OUT"
+	echo "" >> "$OUT"
+fi
+
+section "采集完成"
+echo "日志文件: $OUT" >> "$OUT"
+echo "请将此文件发给方案商/硬件同事" >> "$OUT"
+
+echo "采集完成: $OUT"
+if [ -f "$OUT_DIR/ac107_proof_${STAMP}.wav" ]; then
+	echo "录音样例: $OUT_DIR/ac107_proof_${STAMP}.wav"
+fi
