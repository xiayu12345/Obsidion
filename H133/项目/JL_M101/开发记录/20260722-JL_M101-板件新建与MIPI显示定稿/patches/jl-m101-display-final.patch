+#!/bin/sh
+# TP-H10: UART3 (/dev/ttyS3) init external amp MCU for SPDIF playback (protocol v2.13)
+
+UART_DEV=/dev/ttyS3
+LOCK_FILE=/var/lock/ttyS3.mcu
+INIT_DONE=/tmp/mcu_spdif_init.done
+MCU_PARAMS_PATH=/usr/share/mix_station/参数.txt
+LOG_TAG="[mcu_spdif]"
+
+log() {
+	echo "$LOG_TAG $*"
+}
+
+wait_sndowa() {
+	n=0
+	while [ $n -lt 30 ]; do
+		if grep -q sndowa /proc/asound/cards 2>/dev/null; then
+			log "sndowa ready"
+			return 0
+		fi
+		n=$((n + 1))
+		sleep 1
+	done
+	log "warn: sndowa not found, continue anyway"
+	return 1
+}
+
+open_uart() {
+	if [ ! -e "$UART_DEV" ]; then
+		log "error: $UART_DEV missing"
+		return 1
+	fi
+	stty -F "$UART_DEV" 115200 cs8 -cstopb -parenb raw -echo 2>/dev/null || {
+		log "error: stty $UART_DEV failed"
+		return 1
+	}
+	return 0
+}
+
+mcu_gap() {
+	usleep 30000 2>/dev/null || true
+}
+
+read_master_volume() {
+	vol=2
+	if [ -n "$DESK_MCU_VOLUME" ]; then
+		vol=$DESK_MCU_VOLUME
+	elif [ -f "$MCU_PARAMS_PATH" ]; then
+		v=$(grep -o '"master_volume"[[:space:]]*:[[:space:]]*[0-9][0-9]*' "$MCU_PARAMS_PATH" 2>/dev/null \
+			| head -1 | sed 's/.*:[[:space:]]*//')
+		[ -n "$v" ] && vol=$v
+	fi
+	if [ "$vol" -lt 0 ] 2>/dev/null; then vol=0; fi
+	if [ "$vol" -gt 32 ] 2>/dev/null; then vol=32; fi
+	echo "$vol"
+}
+
+mcu_send_volume() {
+	vol=$1
+	cs=$((0x05 ^ 0x01 ^ 0x01 ^ 0x01 ^ vol))
+	awk -v v="$vol" -v c="$cs" 'BEGIN {
+		printf "%c%c%c%c%c%c%c", 175, 85, 5, 1, 1, 1, v + 0
+		printf "%c", c + 0
+	}' > "$UART_DEV"
+}
+
+rm -f "$INIT_DONE"
+mkdir -p /var/lock 2>/dev/null
+
+(
+	flock -x 9 || {
+		log "error: flock $LOCK_FILE failed"
+		exit 1
+	}
+
+	wait_sndowa
+	open_uart || exit 1
+
+	log "init_start"
+	printf '\xAF\x55\x05\x01\x01\x07\x00\x02' > "$UART_DEV"
+	mcu_gap
+	sleep 1
+
+	log "unmute"
+	printf '\xAF\x55\x05\x01\x01\x02\x09\x0E' > "$UART_DEV"
+	mcu_gap
+
+	MASTER_VOL=$(read_master_volume)
+	log "master volume (priority) vol=$MASTER_VOL"
+	mcu_send_volume "$MASTER_VOL"
+	mcu_gap
+
+	# 切光纤；desk 稍后读 参数.txt 再发全量参数
+
+	log "switch SPDIF mode (0x60)"
+	printf '\xAF\x55\x05\x01\x01\x02\x60\x67' > "$UART_DEV"
+	mcu_gap
+
+	log "init_end"
+	printf '\xAF\x55\x05\x01\x01\x07\x01\x03' > "$UART_DEV"
+	mcu_gap
+
+	log "MCU switched to SPDIF mode"
+) 9>"$LOCK_FILE" || exit 1
+
+touch "$INIT_DONE"
+log "done marker $INIT_DONE"
