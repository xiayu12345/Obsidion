@@ -0,0 +1,19 @@
+#!/bin/sh
+# Test tone via silence/raw -> default or named ALSA PCM (BusyBox-safe, no awk sin)
+DUR="${1:-3}"
+DEV="${2:-default}"
+RATE=48000
+# stereo S16_LE: 4 bytes per frame
+FRAMES=$((RATE * DUR))
+BYTES=$((FRAMES * 4))
+BS=1764
+
+killall aplay 2>/dev/null
+
+left=$BYTES
+while [ "$left" -gt 0 ]; do
+    chunk=$BS
+    [ "$chunk" -gt "$left" ] && chunk=$left
+    dd if=/dev/zero bs="$chunk" count=1 2>/dev/null
+    left=$((left - chunk))
+done | aplay -D "$DEV" -f S16_LE -r "$RATE" -c 2 -t raw
