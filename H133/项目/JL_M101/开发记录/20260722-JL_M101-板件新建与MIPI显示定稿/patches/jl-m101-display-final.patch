@@ -0,0 +1,82 @@
+#!/bin/sh
+
+echo "------run rc.final file-----"
+
+function check_wifi_config_files()
+{
+    default_wifi_dir=/etc/wifi/
+    target_wifi_dir=/mnt/UDISK/
+
+    mkdir -p ${target_wifi_dir}
+
+    cp -r ${default_wifi_dir}/* ${target_wifi_dir}/
+}
+
+check_wifi_config_files
+
+function check_ota_config_file()
+{
+    default_file=/etc/ota_config.ini
+    ota_file=/mnt/UDISK/ota_config.ini
+
+    if [ ! -f ${ota_file} ]; then
+        cp $default_file $ota_file
+    fi
+}
+
+function check_setting_config_file()
+{
+    default_file=/etc/setting.ini
+    setting_file=/mnt/UDISK/setting.ini
+    if [ ! -f ${setting_file} ]; then
+        cp $default_file $setting_file
+    else
+        line=$(wc -l ${setting_file} | awk '{print $1}')
+        if [ $line -lt 10 ]; then
+            cp $default_file $setting_file
+        fi
+    fi
+}
+
+check_setting_config_file
+check_ota_config_file
+
+# WiFi 驱动由 rc 加载；联网由 desk auto_wifi 负责（不用 wifi_autoconnect）
+if [ -x /etc/wifi/load_wifi_modules.sh ]; then
+	/etc/wifi/load_wifi_modules.sh
+	i=0
+	while [ $i -lt 30 ] && [ ! -d /sys/class/net/wlan0 ]; do
+		sleep 1
+		i=$((i + 1))
+	done
+fi
+
+# TP-H10: MCU SPDIF mode first, then ALSA playback route (spdif|hdmi)
+/usr/bin/mcu_spdif_init.sh &
+sleep 4
+/usr/bin/audio_route.sh auto
+
+# audio server init
+amix_server -CS 1 -ADJ 1 -p 1024 -n 4 &
+/usr/bin/amix_server_daemon.sh &
+
+# 共享守护进程：须早于 desk / sing_ktv / ai_mv（busybox-init 无 procd，在此显式拉起）
+# net_service — HTTP/JSON/封面；ktv_song_service 依赖它；desk 由 service_guardian 守护拉起
+[ -x /usr/bin/net_service ] && /usr/bin/net_service &
+[ -x /usr/bin/media_sessiond ] && /usr/bin/media_sessiond &
+[ -x /usr/bin/ktv_song_service ] && /usr/bin/ktv_song_service &
+[ -x /usr/bin/service_guardian ] && /usr/bin/service_guardian &
+sleep 1
+#/usr/bin/lv_daemon.sh &
+
+# 数字人扫码上传 HTTP 服务（ai_mv check_img 轮询 /tmp/status）
+[ -x /usr/bin/led-web-demo ] && led-web-demo &
+
+# OpenSSH + SFTP (sftp-server via /usr/libexec/sftp-server)
+/usr/bin/sshd_start.sh &
+
+# improve water level
+echo 150 > /proc/sys/vm/watermark_scale_factor
+
+# 烧录前串口手动 cat 的同一条：开机自动进 USB Device（ADB）
+cat /sys/devices/platform/soc@3000000/soc@3000000:usbc0@0/usb_device
