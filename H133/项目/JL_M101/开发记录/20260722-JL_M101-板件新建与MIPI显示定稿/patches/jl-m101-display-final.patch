@@ -0,0 +1,32 @@
+#!/bin/sh
+# OpenSSH on Tina busybox-init (no procd): privsep user, host keys, sshd daemon
+
+[ -x /usr/sbin/sshd ] || exit 0
+
+pidof sshd >/dev/null 2>&1 && exit 0
+
+# openssh-server Require-User may not land in passwd on image build
+grep -q '^sshd:' /etc/group  || echo 'sshd:x:22:' >> /etc/group
+grep -q '^sshd:' /etc/passwd || echo 'sshd:x:22:22:sshd:/var/empty:/bin/false' >> /etc/passwd
+grep -q '^sshd:' /etc/shadow || echo 'sshd:*:0:0:99999:7:::' >> /etc/shadow
+
+mkdir -m 0711 -p /var/empty
+chown root:root /var/empty
+
+for type in rsa ed25519; do
+	key="/etc/ssh/ssh_host_${type}_key"
+	if [ ! -f "$key" ] && [ -x /usr/bin/ssh-keygen ]; then
+		/usr/bin/ssh-keygen -N '' -t "$type" -f "$key" 2>/dev/null
+	fi
+done
+
+# OpenSSH 8 default PermitRootLogin=prohibit-password blocks root password login
+if [ -f /etc/ssh/sshd_config ]; then
+	if grep -q '^[# ]*PermitRootLogin' /etc/ssh/sshd_config; then
+		sed -i 's/^[# ]*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
+	else
+		echo 'PermitRootLogin yes' >> /etc/ssh/sshd_config
+	fi
+fi
+
+exec /usr/sbin/sshd
