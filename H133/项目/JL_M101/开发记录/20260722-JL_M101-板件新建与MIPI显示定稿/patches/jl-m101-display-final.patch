+# TP-H10: playback routes spdif | hdmi
+# Switch: /usr/bin/audio_route.sh spdif|hdmi|auto
+
+pcm.PlaybackSPDIF {
+    type plug
+    slave.pcm "hw:sndowa,0"
+    slave.rate 44100
+    slave.format S16_LE
+    slave.channels 2
+}
+
+pcm.PlaybackHDMI {
+    type plug
+    slave.pcm "hw:sndi2s2,0"
+    slave.rate 48000
+    slave.format S16_LE
+    slave.channels 2
+}
+
+pcm.CaptureAC107 {
+    type plug
+    slave.pcm "hw:sndi2s1,0"
+    slave.rate 48000
+    slave.format S16_LE
+    slave.channels 2
+}
+
+pcm.CaptureDsnoop {
+    type plug
+    slave.pcm {
+        type dsnoop
+        ipc_key 2222
+        ipc_perm 0666
+        slave {
+            pcm "hw:sndi2s1,0"
+            rate 48000
+            channels 2
+            format S16_LE
+            period_size 1024
+            periods 4
+        }
+    }
+}
+
+pcm.Playback {
+    type plug
+    slave.pcm {
+        type softvol
+        slave.pcm "PlaybackDmix"
+        control {
+            name "Soft Volume Master"
+            card audiocodec
+        }
+        min_dB -30.0
+        max_dB -2.0
+        resolution 101
+    }
+    slave.rate 48000
+    slave.format S16_LE
+}
+
+pcm.PlaybackDmix {
+    type plug
+    slave.pcm {
+        type dmix
+        ipc_key 1111
+        ipc_perm 0666
+        slave {
+            pcm "hw:audiocodec"
+            format S16_LE
+            rate 48000
+            channels 2
+            period_size 1024
+            periods 4
+        }
+    }
+}
+
+pcm.Capture {
+    type hw
+    card audiocodec
+}
+
+pcm.CaptureMic {
+    type hooks
+    slave.pcm {
+        type plug
+        slave {
+            pcm "CaptureDsnoop"
+            channels 2
+        }
+    }
+    hooks.0 {
+        type ctl_elems
+        hook_args [
+            {
+                name "ADC1 Input LINEINL Switch"
+                optional true
+                value 1
+            }
+            {
+                name "ADC2 Input LINEINR Switch"
+                optional true
+                value 1
+            }
+        ]
+    }
+}
+
+pcm.CaptureHdmiIn {
+    type hw
+    card sndi2s2
+    device 0
+    format S16_LE
+    channels 2
+}
+
+ctl.CaptureHdmiIn {
+    type hw
+    card sndi2s2
+}
+
+# --- default route (audio_route.sh updates playback.pcm and ctl card) ---
+ctl.!default {
+    type hw
+    card sndowa
+}
+
+pcm.!default {
+    type asym
+    playback.pcm "PlaybackSPDIF"
+    capture.pcm "CaptureAC107"
+}
