+			clocks = <&ccu CLK_FANOUT1_OUT>;
+			wlan_busnum    = <0x1>;
+			wlan_regon    = <&pio PG 17 GPIO_ACTIVE_HIGH>;
+			wlan_hostwake  = <&pio PG 10 GPIO_ACTIVE_HIGH>;
+			/*wlan_power    = "VCC-3V3";*/
+			/*wlan_power_vol = <3300000>;*/
+			/*interrupt-parent = <&pio>;
+			interrupts = < PG 10 IRQ_TYPE_LEVEL_HIGH>;*/
+			wakeup-source;
+
+		};
+
+		bt: bt@0 {
+			compatible    = "allwinner,sunxi-bt";
+			pinctrl-0 = <&wlan_pins_a>;
+			pinctrl-names = "default";
+			clock-names = "32k-fanout1";
+			clocks = <&ccu CLK_FANOUT1_OUT>;
+			/*bt_power_num = <0x01>;*/
+			/*bt_power      = "axp803-dldo1";*/
+			/*bt_io_regulator = "axp803-dldo1";*/
+			/*bt_io_vol = <3300000>;*/
+			/*bt_power_vol = <330000>;*/
+			/*bt_rst_n      = <&pio PD 00 GPIO_ACTIVE_HIGH>;*/
+			status        = "okay";
+		};
+	};
+
+	btlpm: btlpm@0 {
+		compatible  = "allwinner,sunxi-btlpm";
+		uart_index  = <0x1>;
+		bt_wake     = <&pio PG 16 GPIO_ACTIVE_HIGH>;
+		bt_hostwake = <&pio PG 18 GPIO_ACTIVE_HIGH>;
+		status      = "okay";
+	};
+
+	addr_mgt: addr_mgt@0 {
+		compatible     = "allwinner,sunxi-addr_mgt";
+		type_addr_wifi = <0x0>;
+		type_addr_bt   = <0x0>;
+		type_addr_eth  = <0x0>;
+		status         = "okay";
+	};
+
+};
+
+&vind0 {
