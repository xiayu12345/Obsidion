+	target@45000008 {
+		reg = <0x0 0x45000008 0x0 0x0>;
+		boot_clock = <1008>;	/*CPU boot frequency, Unit: MHz*/
+		storage_type = <0xffffffff>; /*boot medium, 0-nand, 1-card0, 2-card2, -1(defualt)auto scan*/
+		burn_key = <1>;		/*1:support burn key; 0:not support burn key*/
+		dragonboard_test = <0>;	/*1:support card boot dragonboard; 0:not support card boot dragonboard*/
+	};
+
+	card0_boot_para@2 {
+		/*
+		 * Avoid dtc compiling warnings.
+		 * @TODO: Developer should modify this to the actual value
+		 */
+		reg = <0x0 0x2 0x0 0x0>;
+		device_type = "card0_boot_para";
+		card_ctrl = <0x0>;
+		card_high_speed = <0x1>;
+		card_line = <0x4>;
+		pinctrl-0 = <&sdc0_pins_a>;
+	};
+
+	card2_boot_para@3 {
+		/*
+		 * Avoid dtc compiling warnings.
+		 * @TODO: Developer should modify this to the actual value
+		 */
+		reg = <0x0 0x3 0x0 0x0>;
+		device_type = "card2_boot_para";
+		card_ctrl = <0x2>;
+		card_high_speed = <0x1>;
+		card_line = <0x4>;
+		pinctrl-0 = <&sdc2_pins_a>;
+		/*pinctrl-0 = <&sdc0_pins_a>;*/
+		/*sdc_ex_dly_used = <0x2>;*/
+		sdc_io_1v8 = <0x1>;
+		/*sdc_type = "tm4";*/
+		sdc_tm4_hs200_max_freq = <150>;
+		sdc_tm4_hs400_max_freq = <100>;
+		sdc_ex_dly_used = <2>;
+		/*sdc_tm4_win_th = <8>;*/
+		/*sdc_dis_host_caps = <0x180>;*/
+	};
+
+	rfkill: rfkill@0 {
+		compatible    = "allwinner,sunxi-rfkill";
+		chip_en;
+		power_en;
+		status        = "okay";
+
+		wlan: wlan@0 {
+			compatible    = "allwinner,sunxi-wlan";
+			pinctrl-0 = <&wlan_pins_a>;
+			pinctrl-names = "default";
