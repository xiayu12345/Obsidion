+
+&gmac0 {
+	pinctrl-0 = <&gmac0_pins_a>;
+	pinctrl-1 = <&gmac0_pins_b>;
+	pinctrl-names = "default", "sleep";
+	phy-mode = "rgmii";
+	use_ephy25m = <1>;
