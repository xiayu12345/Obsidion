+static int reopenSoundDeviceLocked(SoundCtrlContext* sc)
+{
+    int ret;
+    SoundStatus old_status;
+
+    TP_CHECK(sc);
+    old_status = sc->sound_status;
+
+    if (old_status == STATUS_START)
+        dropAllPcms(sc);
+    closeSoundDevice(sc);
+
+    ret = openSoundDevice(sc, BLOCK_MODE);
+    if (ret < 0)
+        return ret;
+
+    if (old_status == STATUS_START || old_status == STATUS_PAUSE) {
+        ret = setSoundDeviceParams(sc);
+        if (ret < 0) {
+            closeSoundDevice(sc);
+            sc->sound_status = STATUS_STOP;
+            return ret;
+        }
+        sc->sound_status = old_status;
+        if (old_status == STATUS_START) {
+            ret = prepareAllPcms(sc);
+            if (ret < 0)
+                TLOGE("reopen prepare failed:%s", strerror(errno));
+            else if (sc->dual_output)
+                startSpdifThread(sc);
+        } else if (old_status == STATUS_PAUSE && sc->alsa_can_pause) {
+            ret = snd_pcm_pause(sc->alsa_handler, 1);
+            if (ret < 0)
+                TLOGE("reopen snd_pcm_pause failed:%s", strerror(errno));
+            if (sc->alsa_handler_spdif)
+                snd_pcm_pause(sc->alsa_handler_spdif, 1);
+        }
+    } else if (sc->nSampleRate > 0 && sc->nChannelNum > 0) {
+        ret = setSoundDeviceParams(sc);
+        if (ret < 0) {
+            closeSoundDevice(sc);
+            sc->sound_status = STATUS_STOP;
+            return ret;
+        }
+        sc->sound_status = STATUS_STOP;
+    } else {
+        sc->sound_status = STATUS_STOP;
+    }
 
+    return 0;
 }
