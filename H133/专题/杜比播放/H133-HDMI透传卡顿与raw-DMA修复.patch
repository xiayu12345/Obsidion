+static int setAlsaEnumControl(const char *card, const char *control_name, const char *value)
+{
+    snd_ctl_t *ctl = NULL;
+    snd_ctl_elem_id_t *id = NULL;
+    snd_ctl_elem_info_t *info = NULL;
+    snd_ctl_elem_value_t *ctl_value = NULL;
+    unsigned int item;
+    unsigned int items;
+    int ret;
+
+    ret = snd_ctl_open(&ctl, card, 0);
+    if (ret < 0)
+        return ret;
+
+    snd_ctl_elem_id_malloc(&id);
+    snd_ctl_elem_info_malloc(&info);
+    snd_ctl_elem_value_malloc(&ctl_value);
+    if (id == NULL || info == NULL || ctl_value == NULL) {
+        ret = -ENOMEM;
+        goto out;
+    }
+
+    snd_ctl_elem_id_set_interface(id, SND_CTL_ELEM_IFACE_MIXER);
+    snd_ctl_elem_id_set_name(id, control_name);
+    snd_ctl_elem_info_set_id(info, id);
+    ret = snd_ctl_elem_info(ctl, info);
+    if (ret < 0)
+        goto out;
+
+    items = snd_ctl_elem_info_get_items(info);
+    for (item = 0; item < items; item++) {
+        const char *item_name;
+
+        snd_ctl_elem_info_set_item(info, item);
+        ret = snd_ctl_elem_info(ctl, info);
+        if (ret < 0)
+            goto out;
+
+        item_name = snd_ctl_elem_info_get_item_name(info);
+        if (item_name != NULL && strcmp(item_name, value) == 0) {
+            snd_ctl_elem_value_set_id(ctl_value, id);
+            snd_ctl_elem_value_set_enumerated(ctl_value, 0, item);
+            ret = snd_ctl_elem_write(ctl, ctl_value);
+            goto out;
+        }
+    }
+
+    ret = -EINVAL;
+
+out:
+    if (ctl_value != NULL)
+        snd_ctl_elem_value_free(ctl_value);
+    if (info != NULL)
+        snd_ctl_elem_info_free(info);
+    if (id != NULL)
+        snd_ctl_elem_id_free(id);
+    snd_ctl_close(ctl);
+    return ret;
+}
