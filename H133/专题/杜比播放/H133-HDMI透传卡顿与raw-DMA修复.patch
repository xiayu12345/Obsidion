+static int prepareAllPcms(SoundCtrlContext* sc)
+{
+    int ret;
+
+    if (!sc->alsa_handler)
+        return -1;
+    ret = snd_pcm_prepare(sc->alsa_handler);
+    if (ret < 0) {
