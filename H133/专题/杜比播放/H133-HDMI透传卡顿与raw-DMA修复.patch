+static int setHdmiRawFlag(enum AUIDO_RAW_DATA_TYPE raw_type)
+{
+    const char *value = hdmiRawMixerValue(raw_type);
+    const char *fallback_value = (raw_type == AUDIO_RAW_DATA_PCM) ? "pcm" : NULL;
+    const char *controls[] = {
+        "audio data format",
+        "hdmi audio format Function",
+    };
+    const char *cards[] = {
+        HDMI_CTL_PRIMARY,
+        HDMI_CTL_FALLBACK,
+    };
+    size_t ci;
+    size_t vi;
+    int ret = -EINVAL;
+
+    for (ci = 0; ci < sizeof(cards) / sizeof(cards[0]); ci++) {
+        for (vi = 0; vi < sizeof(controls) / sizeof(controls[0]); vi++) {
+            ret = setAlsaEnumControl(cards[ci], controls[vi], value);
+            if (ret < 0 && fallback_value != NULL)
+                ret = setAlsaEnumControl(cards[ci], controls[vi], fallback_value);
+            if (ret >= 0) {
+                printf("PT HDMI raw flag card=%s control=%s value=%s\n",
+                       cards[ci], controls[vi], value);
+                return 0;
+            }
+        }
+    }
+
+    TLOGE("set HDMI raw flag %s failed, ret=%d", value, ret);
+    return ret;
+}
