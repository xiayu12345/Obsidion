+static int dropAllPcms(SoundCtrlContext* sc)
+{
+    int ret = 0;
+    int ret2;
+
+    if (sc->alsa_handler && (ret2 = snd_pcm_drop(sc->alsa_handler)) < 0)
+        ret = ret2;
+    if (sc->alsa_handler_spdif && (ret2 = snd_pcm_drop(sc->alsa_handler_spdif)) < 0)
+        ret = ret2;
     return ret;
+}
+
+static snd_pcm_sframes_t writePcmWithRecover(SoundCtrlContext* sc, snd_pcm_t *pcm,
+        void *pData, snd_pcm_uframes_t num_frames)
+{
+    snd_pcm_uframes_t written = 0;
+    snd_pcm_uframes_t remaining = num_frames;
+    char *ptr = (char*)pData;
+    size_t frame_bytes = masterFrameBytes(sc);
+
+    if (!pcm)
+        return -EINVAL;
+    if (num_frames == 0)
+        return 0;
+    if (frame_bytes == 0)
+        frame_bytes = 4;
+
+    while (remaining > 0) {
+        snd_pcm_sframes_t res = snd_pcm_writei(pcm, ptr, remaining);
+
+        if (res == -EINTR) {
+            continue;
+        }
+        if (res == -ESTRPIPE) {
+            while ((res = snd_pcm_resume(pcm)) == -EAGAIN)
+                sleep(1);
+            continue;
+        }
+        if (res == -EPIPE) {
+            TLOGD("MSGTR_AO_ALSA_PcmXrunTryingRecover");
+            res = snd_pcm_recover(pcm, (int)res, 1);
+            if (res < 0) {
+                snd_pcm_prepare(pcm);
+            }
+            continue;
+        }
+        if (res < 0) {
+            TLOGE("MSGTR_AO_ALSA_WriteError,res = %ld", (long)res);
+            snd_pcm_prepare(pcm);
+            return (written > 0) ? (snd_pcm_sframes_t)written : res;
+        }
+
+        written += (snd_pcm_uframes_t)res;
+        remaining -= (snd_pcm_uframes_t)res;
+        ptr += (size_t)res * frame_bytes;
+    }
+
+    return (snd_pcm_sframes_t)written;
+}
+
+/* IEC61937 burst 间允许补 0；只在 HDMI raw 已 RUNNING 且剩余不足 2 period 时补一包。 */
+static int writeHdmiIecStuffingIfStarved(SoundCtrlContext* sc)
+{
+    static int16_t zero[HDMI_IEC_STUFF_MAX_FRAMES * 2];
+    snd_pcm_sframes_t avail;
+    snd_pcm_uframes_t period;
+    snd_pcm_uframes_t buffer;
+    snd_pcm_uframes_t filled;
+    snd_pcm_uframes_t chunk;
+    snd_pcm_state_t st;
+
+    if (!sc || !sc->alsa_handler || !sc->hdmi_raw_active)
+        return 0;
+
+    st = snd_pcm_state(sc->alsa_handler);
+    if (st != SND_PCM_STATE_RUNNING)
+        return 0;
+
+    avail = snd_pcm_avail(sc->alsa_handler);
+    if (avail < 0)
+        return 0;
+
+    period = sc->period_size ? sc->period_size : HDMI_IEC_STUFF_MAX_FRAMES;
+    buffer = period * (sc->period_count ? sc->period_count : 8);
+    if ((snd_pcm_uframes_t)avail >= buffer)
+        filled = 0;
+    else
+        filled = buffer - (snd_pcm_uframes_t)avail;
+
+    if (filled >= period * 2)
+        return 0;
+
+    chunk = period;
+    if (chunk > HDMI_IEC_STUFF_MAX_FRAMES)
+        chunk = HDMI_IEC_STUFF_MAX_FRAMES;
+    (void)writePcmWithRecover(sc, sc->alsa_handler, zero, chunk);
+    return 0;
+}
