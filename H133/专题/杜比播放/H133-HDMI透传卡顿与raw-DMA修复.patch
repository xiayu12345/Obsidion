+static AudioRouteMode readAudioRouteMode(void)
+{
+    FILE *f;
+    char buf[16];
+
+    f = fopen(AUDIO_ROUTE_MODE_FILE, "r");
+    if (!f)
+        return AUDIO_ROUTE_SPDIF;
+    if (!fgets(buf, sizeof(buf), f)) {
+        fclose(f);
+        return AUDIO_ROUTE_SPDIF;
+    }
+    fclose(f);
+    if (strncmp(buf, "spdif", 5) == 0)
+        return AUDIO_ROUTE_SPDIF;
+    if (strncmp(buf, "hdmi", 4) == 0)
+        return AUDIO_ROUTE_HDMI;
+    if (strncmp(buf, "dual", 4) == 0)
+        return AUDIO_ROUTE_DUAL;
+    return AUDIO_ROUTE_SPDIF;
+}
