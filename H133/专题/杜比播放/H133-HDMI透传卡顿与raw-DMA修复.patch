+static void spdifRingReset(SoundCtrlContext* sc)
+{
+    if (!sc)
+        return;
+    pthread_mutex_lock(&sc->spdif_ring_mutex);
+    sc->spdif_ring_rd = 0;
+    sc->spdif_ring_wr = 0;
+    sc->spdif_ring_used = 0;
+    pthread_mutex_unlock(&sc->spdif_ring_mutex);
+}
+
+static int spdifRingWrite(SoundCtrlContext* sc, const void *data, size_t bytes)
+{
+    size_t first;
+    const char *src = (const char*)data;
+
+    if (!sc || !data || bytes == 0)
+        return 0;
+
+    pthread_mutex_lock(&sc->spdif_ring_mutex);
+    while (sc->spdif_ring_used + bytes > sc->spdif_ring_size && !sc->spdif_thread_stop) {
+        pthread_cond_wait(&sc->spdif_ring_cond, &sc->spdif_ring_mutex);
+    }
+    if (sc->spdif_thread_stop) {
+        pthread_mutex_unlock(&sc->spdif_ring_mutex);
+        return -1;
+    }
+
+    first = sc->spdif_ring_size - sc->spdif_ring_wr;
+    if (bytes <= first) {
+        memcpy(sc->spdif_ring_buf + sc->spdif_ring_wr, src, bytes);
+    } else {
+        memcpy(sc->spdif_ring_buf + sc->spdif_ring_wr, src, first);
+        memcpy(sc->spdif_ring_buf, src + first, bytes - first);
+    }
+    sc->spdif_ring_wr = (sc->spdif_ring_wr + bytes) % sc->spdif_ring_size;
+    sc->spdif_ring_used += bytes;
+    pthread_cond_signal(&sc->spdif_ring_cond);
+    pthread_mutex_unlock(&sc->spdif_ring_mutex);
+    return 0;
+}
+
+static size_t spdifRingRead(SoundCtrlContext* sc, void *dst, size_t bytes)
+{
+    size_t first;
+    char *out = (char*)dst;
+
+    pthread_mutex_lock(&sc->spdif_ring_mutex);
+    while (sc->spdif_ring_used < bytes && !sc->spdif_thread_stop) {
+        if (sc->sound_status != STATUS_START)
+            break;
+        pthread_cond_wait(&sc->spdif_ring_cond, &sc->spdif_ring_mutex);
+    }
+    if (sc->spdif_ring_used < bytes) {
+        bytes = sc->spdif_ring_used;
+    }
+    if (bytes == 0) {
+        pthread_mutex_unlock(&sc->spdif_ring_mutex);
+        return 0;
+    }
+
+    first = sc->spdif_ring_size - sc->spdif_ring_rd;
+    if (bytes <= first) {
+        memcpy(out, sc->spdif_ring_buf + sc->spdif_ring_rd, bytes);
+    } else {
+        memcpy(out, sc->spdif_ring_buf + sc->spdif_ring_rd, first);
+        memcpy(out + first, sc->spdif_ring_buf, bytes - first);
+    }
+    sc->spdif_ring_rd = (sc->spdif_ring_rd + bytes) % sc->spdif_ring_size;
+    sc->spdif_ring_used -= bytes;
+    pthread_cond_signal(&sc->spdif_ring_cond);
+    pthread_mutex_unlock(&sc->spdif_ring_mutex);
+    return bytes;
+}
+
+static void *spdifThreadMain(void *arg)
+{
+    SoundCtrlContext* sc = (SoundCtrlContext*)arg;
+    char chunk[AUDIO_POST_PROC_PCM_BUFSIZE];
+    size_t frame_bytes;
+    size_t chunk_bytes;
+
+    frame_bytes = masterFrameBytes(sc);
+    if (frame_bytes == 0)
+        frame_bytes = 4;
+    chunk_bytes = frame_bytes * 1024;
+
+    while (!sc->spdif_thread_stop) {
+        size_t got = spdifRingRead(sc, chunk, chunk_bytes);
+        if (got == 0) {
+            if (sc->spdif_thread_stop)
+                break;
+            continue;
+        }
+        if (sc->sound_status == STATUS_START && sc->alsa_handler_spdif) {
+            snd_pcm_uframes_t frames = got / frame_bytes;
+            if (frames > 0)
+                (void)writePcmWithRecover(sc, sc->alsa_handler_spdif, chunk, frames);
+        }
+    }
+    return NULL;
+}
+
+static int startSpdifThread(SoundCtrlContext* sc)
+{
+    int ret;
+
+    if (!sc || !sc->dual_output || !sc->alsa_handler_spdif || sc->spdif_thread_started)
+        return 0;
+
+    sc->spdif_thread_stop = 0;
+    spdifRingReset(sc);
+    ret = pthread_create(&sc->spdif_thread, NULL, spdifThreadMain, sc);
+    if (ret != 0) {
+        TLOGE("spdif thread create failed:%s", strerror(ret));
+        return -1;
+    }
+    sc->spdif_thread_started = 1;
+    TLOGD("spdif thread started");
+    return 0;
+}
+
+static void stopSpdifThread(SoundCtrlContext* sc)
+{
+    if (!sc || !sc->spdif_thread_started)
+        return;
+
+    pthread_mutex_lock(&sc->spdif_ring_mutex);
+    sc->spdif_thread_stop = 1;
+    pthread_cond_broadcast(&sc->spdif_ring_cond);
+    pthread_mutex_unlock(&sc->spdif_ring_mutex);
+    pthread_join(sc->spdif_thread, NULL);
+    sc->spdif_thread_started = 0;
+    sc->spdif_thread_stop = 0;
+    spdifRingReset(sc);
+    TLOGD("spdif thread stopped");
+}
