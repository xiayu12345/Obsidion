+static void sound_ctrl_register(SoundCtrlContext* sc)
+{
+    int i;
+
+    if (!sc)
+        return;
+    pthread_mutex_lock(&g_sound_ctrl_list_mutex);
+    for (i = 0; i < MAX_SOUND_CTRL_INSTANCES; i++) {
+        if (g_sound_ctrls[i] == sc) {
+            pthread_mutex_unlock(&g_sound_ctrl_list_mutex);
+            return;
+        }
+    }
+    for (i = 0; i < MAX_SOUND_CTRL_INSTANCES; i++) {
+        if (g_sound_ctrls[i] == NULL) {
+            g_sound_ctrls[i] = sc;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_sound_ctrl_list_mutex);
+}
+
+static void sound_ctrl_unregister(SoundCtrlContext* sc)
+{
+    int i;
+
+    if (!sc)
+        return;
+    pthread_mutex_lock(&g_sound_ctrl_list_mutex);
+    for (i = 0; i < MAX_SOUND_CTRL_INSTANCES; i++) {
+        if (g_sound_ctrls[i] == sc) {
+            g_sound_ctrls[i] = NULL;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_sound_ctrl_list_mutex);
+}
