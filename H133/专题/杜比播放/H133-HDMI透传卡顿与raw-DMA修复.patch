+                TLOGE("audio_port_close_device failed!");
+            }
+            if (sc->sound_status == STATUS_START || sc->sound_status == STATUS_PAUSE) {
+                if (openSoundDevice(sc, BLOCK_MODE) == 0) {
+                    sc->sound_status = STATUS_START;
+                }
+            }
+        }
+#endif
+        pthread_mutex_unlock(&sc->mutex);
+    }
+    pthread_mutex_unlock(&g_sound_ctrl_list_mutex);
+}
