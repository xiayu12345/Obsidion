+static int openOnePcm(snd_pcm_t **handler, const char *name, int mode)
+{
+    int ret;
+
+    if (*handler) {
+        printf("PT ALSA audio device %s already open\n", name);
+        return 0;
+    }
+    ret = snd_pcm_open(handler, name, SND_PCM_STREAM_PLAYBACK, mode);
+    if (ret < 0) {
+        TLOGE("open audio device %s failed:%s, errno = %d", name, strerror(errno), errno);
+        printf("PT ALSA open audio device %s failed ret=%d errno=%d\n", name, ret, errno);
+    } else {
+        TLOGD("open audio device %s ok", name);
+        printf("PT ALSA open audio device %s ok\n", name);
+    }
+    return ret;
+}
+
+static int openHdmiRawPcm(SoundCtrlContext* sc, int mode)
+{
+    int ret;
+
+    printf("PT HDMI raw open begin raw=%d rate=%u period=%u/%u\n",
+           sc->raw_type, sc->nSampleRate, sc->period_size, sc->period_count);
+    ret = setHdmiRawFlag(sc->raw_type);
+    if (ret < 0)
+        return ret;
+
+    ret = openOnePcm(&sc->alsa_handler, HDMI_PCM_PRIMARY, mode);
+    if (ret < 0)
+        ret = openOnePcm(&sc->alsa_handler, HDMI_PCM_FALLBACK, mode);
+
+    if (ret < 0) {
+        setHdmiRawFlag(AUDIO_RAW_DATA_PCM);
+        return ret;
+    }
+
+    sc->hdmi_raw_active = 1;
+    printf("PT HDMI raw open ok raw=%d\n", sc->raw_type);
+    return 0;
+}
+
+static void restoreHdmiRawPcm(SoundCtrlContext* sc)
+{
+    if (sc != NULL && sc->hdmi_raw_active) {
+        setHdmiRawFlag(AUDIO_RAW_DATA_PCM);
+        sc->hdmi_raw_active = 0;
+    }
+}
