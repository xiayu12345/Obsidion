+static void expandMonoToStereo(SoundCtrlContext* sc, int16_t* buf, int mono_frames)
+{
+    int i;
+
+    (void)sc;
+    if (!buf || mono_frames <= 0)
+        return;
+    for (i = mono_frames - 1; i >= 0; i--) {
+        buf[i * 2] = buf[i];
+        buf[i * 2 + 1] = buf[i];
