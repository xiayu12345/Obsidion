-        else
-            printf("fb G2D dmabuf fd=%d (smem_start=0x%lx)\n", sinfo.fb_dma_fd,
-                   (unsigned long) finfo.smem_start);
 #endif /* USE_SUNXIFB_G2D */
 
 #ifdef SUNXIFB_ROTATE_EN
@@ -356,19 +303,11 @@ void sunxifb_init(uint32_t rotated) {
 
             fbp = sinfo.rotatefbp;
