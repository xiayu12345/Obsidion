 #define AAS_MCU_SETTLE_MS     200000
 
+/* 2.4G 空鼠麦：/proc/asound/cards 里常见 [Mouse] / USB-Audio */
+static int aas_capture_usb_present(void)
+{
+    FILE *fp;
+    char line[256];
+    int found = 0;
+
+    fp = fopen(AAS_PROC_CARDS, "r");
+    if (!fp) {
+        return 0;
+    }
+    while (fgets(line, sizeof(line), fp) != NULL) {
+        if (strstr(line, "USB-Audio") != NULL ||
+            strstr(line, "[Mouse") != NULL ||
+            strstr(line, "Wireless Air Mouse") != NULL) {
+            found = 1;
+            break;
+        }
+    }
+    fclose(fp);
+    return found;
+}
+
 static int aas_capture_profile_needs_mcu(aas_capture_profile_t profile)
 {
+    if (g_use_usb) {
+        return 0;
+    }
     return profile == AAS_PROFILE_RECORD_44100_STEREO ||
            profile == AAS_PROFILE_ASR_16K_MONO;
 }
