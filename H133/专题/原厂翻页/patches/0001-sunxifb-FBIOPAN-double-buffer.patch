 void sunxifb_hdmi_rotate_restore(void);
 void sunxifb_flush(lv_disp_drv_t * drv, const lv_area_t * area, lv_color_t * color_p);
 void sunxifb_get_sizes(uint32_t *width, uint32_t *height);
diff --git a/platform/thirdparty/gui/lvgl-8/lv_drivers/lv_port_disp.c b/platform/thirdparty/gui/lvgl-8/lv_drivers/lv_port_disp.c
index d93af3b40..d902b8896 100644
--- a/platform/thirdparty/gui/lvgl-8/lv_drivers/lv_port_disp.c
+++ b/platform/thirdparty/gui/lvgl-8/lv_drivers/lv_port_disp.c
@@ -30,8 +30,9 @@ void lv_port_disp_apply_rotate(lv_disp_drv_t *drv, uint32_t sunxi_rot)
         drv->sw_rotate = 1;
 #endif
 
-#ifdef USE_SUNXIFB_SOFT_ROTATE
-    /* 旋转仅 sunxifb 负责，避免 LVGL 再变换触摸坐标 */
+#if defined(USE_SUNXIFB_G2D_ROTATE) || defined(USE_SUNXIFB_SOFT_ROTATE)
+    /* G2D/软转：logical_size 已按旋转换宽高，rotated 必须 NONE。
