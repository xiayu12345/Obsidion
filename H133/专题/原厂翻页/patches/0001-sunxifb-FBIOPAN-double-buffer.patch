  */
 void lv_port_disp_apply_rotate(lv_disp_drv_t *drv, uint32_t sunxi_rot);
 

diff --git a/openwrt/package/thirdparty/gui/lvgl-8/liblvgl/Config.in b/openwrt/package/thirdparty/gui/lvgl-8/liblvgl/Config.in
index 4f0fa2120..89072c0ec 100644
