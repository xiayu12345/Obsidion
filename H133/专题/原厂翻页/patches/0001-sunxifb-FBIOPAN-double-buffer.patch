+    }
+#endif /* USE_SUNXIFB_SOFT_ROTATE */
+
     switch (sinfo.rotated) {
     case SUNXIFB_ROT_90:
         for (i = 0; i < desH; i++) {
diff --git a/platform/thirdparty/gui/lvgl-8/lv_drivers/display/sunxifb.h b/platform/thirdparty/gui/lvgl-8/lv_drivers/display/sunxifb.h
index 4e449f53a..69358493b 100644
--- a/platform/thirdparty/gui/lvgl-8/lv_drivers/display/sunxifb.h
+++ b/platform/thirdparty/gui/lvgl-8/lv_drivers/display/sunxifb.h
@@ -29,11 +29,6 @@ extern "C" {
 #include "lvgl/lvgl.h"
 #endif
 
-/* G2D 暂不可用时由 sunxifb 做整帧 CPU 旋转；恢复 G2D 后在 menuconfig 开 LVGL8_USE_SUNXIFB_G2D_ROTATE */
-#ifndef USE_SUNXIFB_G2D_ROTATE
-#define USE_SUNXIFB_SOFT_ROTATE
-#endif
-
 /*********************
  *      DEFINES
  *********************/
@@ -48,7 +43,6 @@ extern "C" {
 void sunxifb_set_lv_resolution(uint32_t w, uint32_t h);
 void sunxifb_init(uint32_t rotated);
 void sunxifb_exit(void);
