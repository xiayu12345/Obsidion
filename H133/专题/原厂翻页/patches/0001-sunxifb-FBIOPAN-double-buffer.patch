     drv->rotated = LV_DISP_ROT_NONE;
 #else
     if (sunxi_rot > 3)
diff --git a/platform/thirdparty/gui/lvgl-8/lv_drivers/lv_port_disp.h b/platform/thirdparty/gui/lvgl-8/lv_drivers/lv_port_disp.h
index 0eed02ff2..31fa3059f 100644
--- a/platform/thirdparty/gui/lvgl-8/lv_drivers/lv_port_disp.h
+++ b/platform/thirdparty/gui/lvgl-8/lv_drivers/lv_port_disp.h
@@ -23,7 +23,7 @@ void lv_port_disp_logical_size_from_fb(uint32_t fb_w, uint32_t fb_h,
 
 /**
