index 000000000..90290507e
--- /dev/null
+++ b/H133-AI-Skills/skills/h133-build/scripts/build_p1_nor_jyy070.sh
@@ -0,0 +1,120 @@
+#!/bin/bash
+# H133 p1_nor_jyy070 编译脚本 — 由 .cursor/skills/h133-build 提供
+# Usage: build_p1_nor_jyy070.sh [full|kernel|rootfs]
+
+ROOT="${H133_SDK_ROOT:-$(cd "$(dirname "$0")/../../../.." && pwd)}"
+cd "$ROOT" || exit 1
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+
+# SDK 自带 python3.8，Ubuntu 20.04+ 默认无 python 命令
+if ! command -v python >/dev/null 2>&1; then
+	export PATH="$ROOT/prebuilt/hostbuilt/python3.8/bin:${PATH:-}"
+	mkdir -p "$ROOT/.local/bin"
+	ln -sf "$ROOT/prebuilt/hostbuilt/python3.8/bin/python3" "$ROOT/.local/bin/python" 2>/dev/null || true
+	export PATH="$ROOT/.local/bin:${PATH:-}"
+fi
+if ! command -v python >/dev/null 2>&1; then
+	echo "error: python not found. 请安装: sudo apt install -y python-is-python3" >&2
+	exit 1
+fi
+
+# 无系统 gcc 时才加载离线 host 工具链
+if ! command -v gcc >/dev/null 2>&1; then
+	[ -f "$SCRIPT_DIR/env_host.sh" ] && source "$SCRIPT_DIR/env_host.sh"
+fi
+if ! command -v make >/dev/null 2>&1; then
+	export PATH="$ROOT/prebuilt/hostbuilt/make4.1/bin:${PATH:-}"
+fi
+if ! command -v make >/dev/null 2>&1; then
+	echo "error: make not found. 请先安装: sudo apt install -y build-essential" >&2
+	exit 1
+fi
+if ! command -v gcc >/dev/null 2>&1; then
+	echo "error: gcc not found. 请先安装: sudo apt install -y build-essential" >&2
+	exit 1
+fi
+
+if [ ! -f "build/envsetup.sh" ]; then
+	echo "error: not in H133 SDK root (missing build/envsetup.sh): $ROOT" >&2
+	exit 1
+fi
+
+# envsetup 会 source openwrt/build/envsetup.sh，其中 unalias make 在无别名时 exit 1；
+# 不能与 set -e 同时使用，否则脚本在 load openwrt 后立刻退出。
+set +e
+# shellcheck source=/dev/null
+source build/envsetup.sh
+_envsetup_ret=$?
+set -e
+if [ "$_envsetup_ret" -ne 0 ]; then
+	echo "error: source build/envsetup.sh failed ($_envsetup_ret)" >&2
+	exit 1
+fi
+
+MODE="${1:-full}"
+NPROC="$(nproc 2>/dev/null || echo 4)"
+
+# 从备份覆盖 disp 源文件后 mtime 可能更旧，须 touch 否则 .o 不重建、触摸 I2C 仍异常
+touch_disp_for_rebuild() {
+	local d="$ROOT/kernel/linux-5.4/drivers/video/fbdev/sunxi/disp2"
+	touch "$d/disp/dev_disp.c" "$d/disp/dev_fb.c" "$d/hdmi2/hdmi_tx.c" 2>/dev/null || true
+}
+
+# lv_projector 打包时复制 ../lv_drivers，须随 sunxifb 变更触发重编
+touch_lvgl_sunxifb_for_rebuild() {
+	local f="$ROOT/platform/thirdparty/gui/lvgl-8/lv_drivers/display/sunxifb.c"
+	touch "$f" 2>/dev/null || true
+	rm -rf "$ROOT/out/h133/p1_nor_jyy070/openwrt/build_dir/target/lv_projector" 2>/dev/null || true
+}
+
+case "$MODE" in
+kernel)
+	echo "==> ./build.sh kernel bootloader"
+	touch_disp_for_rebuild
+	./build.sh kernel bootloader
+	# 内核产物在 kernel/staging，需同步到 openwrt 再 p 才会打进 img
+	if [ -f "$ROOT/out/h133/kernel/staging/boot.img" ]; then
+		cp -a "$ROOT/out/h133/kernel/staging/boot.img" \
+			"$ROOT/out/h133/kernel/staging/uImage" \
+			"$ROOT/out/h133/p1_nor_jyy070/openwrt/"
+		echo "==> synced kernel staging -> openwrt/"
+	fi
+	;;
+rootfs)
+	echo "==> m + p (no kernel rebuild)"
+	touch_lvgl_sunxifb_for_rebuild
+	m -j"${NPROC}"
+	p
+	;;
+full)
+	echo "==> ./build.sh kernel bootloader + m + p"
+	touch_disp_for_rebuild
+	./build.sh kernel bootloader
+	if [ -f "$ROOT/out/h133/kernel/staging/boot.img" ]; then
+		cp -a "$ROOT/out/h133/kernel/staging/boot.img" \
+			"$ROOT/out/h133/kernel/staging/uImage" \
+			"$ROOT/out/h133/p1_nor_jyy070/openwrt/"
+		echo "==> synced kernel staging -> openwrt/"
+	fi
+	touch_lvgl_sunxifb_for_rebuild
+	m -j"${NPROC}"
+	p
+	;;
+*)
+	echo "Usage: $0 [full|kernel|rootfs]" >&2
+	echo "  full   - kernel+bootloader, then m, p (default)" >&2
+	echo "  kernel - only ./build.sh kernel bootloader" >&2
+	echo "  rootfs - only m + p" >&2
+	exit 1
+	;;
+esac
+
+IMG="$ROOT/out/h133_linux_p1_nor_jyy070_uart0_nor.img"
+if [ -f "$IMG" ]; then
+	echo "==> OK: $IMG"
+	ls -la "$IMG"
+	md5sum "$IMG" 2>/dev/null || true
+else
+	echo "==> note: image not found (kernel-only mode?): $IMG"
+fi
