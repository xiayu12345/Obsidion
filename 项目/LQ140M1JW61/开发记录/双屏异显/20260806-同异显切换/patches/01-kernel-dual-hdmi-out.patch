+static int disp_dual_display_set_hdmi_output(bool on)
+{
+	struct disp_manager *mgr1;
+	struct disp_layer_config cfg;
+
+	mutex_lock(&g_dual_display_mutex);
+	if (g_dual_display_hdmi_output == on) {
+		mutex_unlock(&g_dual_display_mutex);
+		return 0;
+	}
+	g_dual_display_hdmi_output = on;
+
+	mgr1 = g_disp_drv.mgr[1];
+	if (!g_dual_display_enabled || !mgr1 || !mgr1->set_layer_config) {
+		mutex_unlock(&g_dual_display_mutex);
+		pr_info("[DISP] dual HDMI output %s (wb %s)\n",
+			on ? "on" : "off",
+			g_dual_display_enabled ? "up" : "down");
+		return 0;
+	}
+
+	if (!on) {
+		if (g_dual_display_hdmi_layer_ready) {
+			cfg = g_dual_display_hdmi_layer;
+			cfg.enable = 0;
+			mgr1->set_layer_config(mgr1, &cfg, 1);
+			g_dual_display_hdmi_layer.enable = 0;
+		}
