Subject: [PATCH] p1_nor_4k board: shared hooks (.openwrt_targets + libtmedia + sibling not-set)

---
diff --git a/openwrt/.openwrt_targets b/openwrt/.openwrt_targets
--- a/openwrt/.openwrt_targets	2026-07-23 02:30:38.437426893 -0700
+++ b/openwrt/.openwrt_targets	2026-07-23 02:30:38.441426902 -0700
@@ -1,3 +1,4 @@
+h133-p1_nor_4k-tina
 h133-p1_nor_8733-tina
 h133-p1_nor_JL_M101-tina
 h133-p1_nor_JYY070-tina
diff --git a/openwrt/package/allwinner/multimedia/tina_multimedia/libtmedia/Makefile b/openwrt/package/allwinner/multimedia/tina_multimedia/libtmedia/Makefile
--- a/openwrt/package/allwinner/multimedia/tina_multimedia/libtmedia/Makefile	2026-07-23 02:30:38.449426921 -0700
+++ b/openwrt/package/allwinner/multimedia/tina_multimedia/libtmedia/Makefile	2026-07-23 02:30:38.453426930 -0700
@@ -66,11 +66,11 @@
 endif
 
 # WB mirror CPU 旋转角（度）；按 target -D，tlayer_ctrl #if VIDEO_WB_MIRROR_ROTATE
-# JYY070；p1_nor / p1_nor_8733 / p1_nor_JL_M101=90（UI 旋转树内用头文件默认，不由此 mk 控制）
+# JYY070 / p1_nor_4k=0；p1_nor / p1_nor_8733 / p1_nor_JL_M101=90（UI 旋转树内用头文件默认，不由此 mk 控制）
 ifeq ($(CONFIG_TARGET_h133_p1_nor)$(CONFIG_TARGET_h133_p1_nor_8733)$(CONFIG_TARGET_h133_p1_nor_JL_M101),y)
 TARGET_CFLAGS+=-DVIDEO_WB_MIRROR_ROTATE=90
 endif
-ifeq ($(CONFIG_TARGET_h133_p1_nor_JYY070),y)
+ifeq ($(CONFIG_TARGET_h133_p1_nor_JYY070)$(CONFIG_TARGET_h133_p1_nor_4k),y)
 TARGET_CFLAGS+=-DVIDEO_WB_MIRROR_ROTATE=0
 endif
 
diff --git a/openwrt/target/h133/h133-p1_nor/defconfig b/openwrt/target/h133/h133-p1_nor/defconfig
--- a/openwrt/target/h133/h133-p1_nor/defconfig	2026-07-23 02:30:38.493427023 -0700
+++ b/openwrt/target/h133/h133-p1_nor/defconfig	2026-07-23 02:30:38.493427023 -0700
@@ -8,6 +8,7 @@
 # CONFIG_TARGET_h133_p1_nor_8733 is not set
 # CONFIG_TARGET_h133_p1_nor_JYY070 is not set
 # CONFIG_TARGET_h133_p1_nor_JL_M101 is not set
+# CONFIG_TARGET_h133_p1_nor_4k is not set
 # CONFIG_TARGET_h133_p2 is not set
 CONFIG_TARGET_h133_p1_nor_Default=y
 CONFIG_TARGET_BOARD="h133-p1_nor"
diff --git a/openwrt/target/h133/h133-p1_nor_8733/defconfig b/openwrt/target/h133/h133-p1_nor_8733/defconfig
--- a/openwrt/target/h133/h133-p1_nor_8733/defconfig	2026-07-23 02:30:38.497427032 -0700
+++ b/openwrt/target/h133/h133-p1_nor_8733/defconfig	2026-07-23 02:30:38.497427032 -0700
@@ -7,6 +7,7 @@
 # CONFIG_TARGET_h133_p1_nor is not set
 CONFIG_TARGET_h133_p1_nor_8733=y
 # CONFIG_TARGET_h133_p1_nor_JL_M101 is not set
+# CONFIG_TARGET_h133_p1_nor_4k is not set
 # CONFIG_TARGET_h133_p1_nor_JYY070 is not set
 # CONFIG_TARGET_h133_p2 is not set
 CONFIG_TARGET_h133_p1_nor_8733_Default=y
diff --git a/openwrt/target/h133/h133-p1_nor_JL_M101/defconfig b/openwrt/target/h133/h133-p1_nor_JL_M101/defconfig
--- a/openwrt/target/h133/h133-p1_nor_JL_M101/defconfig	2026-07-23 02:30:38.505427051 -0700
+++ b/openwrt/target/h133/h133-p1_nor_JL_M101/defconfig	2026-07-23 02:30:38.505427051 -0700
@@ -7,6 +7,7 @@
 # CONFIG_TARGET_h133_p1_nor is not set
 # CONFIG_TARGET_h133_p1_nor_8733 is not set
 CONFIG_TARGET_h133_p1_nor_JL_M101=y
+# CONFIG_TARGET_h133_p1_nor_4k is not set
 # CONFIG_TARGET_h133_p1_nor_JYY070 is not set
 # CONFIG_TARGET_h133_p2 is not set
 CONFIG_TARGET_h133_p1_nor_JL_M101_Default=y
diff --git a/openwrt/target/h133/h133-p1_nor_JYY070/defconfig b/openwrt/target/h133/h133-p1_nor_JYY070/defconfig
--- a/openwrt/target/h133/h133-p1_nor_JYY070/defconfig	2026-07-23 02:30:38.501427041 -0700
+++ b/openwrt/target/h133/h133-p1_nor_JYY070/defconfig	2026-07-23 02:30:38.501427041 -0700
@@ -8,6 +8,7 @@
 # CONFIG_TARGET_h133_p1_nor_8733 is not set
 CONFIG_TARGET_h133_p1_nor_JYY070=y
 # CONFIG_TARGET_h133_p1_nor_JL_M101 is not set
+# CONFIG_TARGET_h133_p1_nor_4k is not set
 # CONFIG_TARGET_h133_p2 is not set
 CONFIG_TARGET_h133_p1_nor_JYY070_Default=y
 # CONFIG_TARGET_h133_p1_nor_JL_M101 is not set
